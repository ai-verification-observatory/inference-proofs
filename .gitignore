# Local agent harness files
.agents/harness/

# OS and editors
**/.DS_Store
.idea/
.vscode/
*.swp

# Python (harness/, managed with uv; uv.lock is committed)
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Node
**/node_modules

# Runner scratch inside a results tree (RFC-0010): staging dirs and the lock
results/**/.staging-*/
results/.runner.lock
results/.selftest.json
# proof archives kept on the runner until uploaded (RFC-0014, RFC-0009 Q1)
results/.archive/
# job io directories kept with --keep-io hold proof bytes (RFC-0009: never committed)
results/**/io/

# Secrets (AGENTS.md rule 7)
.env
.env.*
*.pem
*.key

# Model weights never enter the repository (AGENTS.md rule 8; RFC-0003).
# Toy weights for CPU fixtures are allowed under tests/fixtures/.
*.safetensors
*.gguf
*.pt
*.pth
*.ckpt
*.onnx
!harness/tests/fixtures/**
!systems/*/tests/fixtures/**
# the negations above must not bring back bytecode caches
harness/tests/fixtures/**/__pycache__/
systems/*/tests/fixtures/**/__pycache__/

# coverage reports (make ci, the tests job)
coverage.json
.coverage

