{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "rm -rf public && mkdir -p public/og public/fonts && cp *.html words.css words.js search.json public/ && cp og/*.png og/*.svg public/og/ && cp fonts/*.woff2 public/fonts/",
  "cleanUrls": true,
  "framework": null,
  "headers": [
    {
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-BvfZjEgH5q5tQ8fzRtC/NtSi5j+O9wxUdXmwLgOx10w=' https://cdn.vercel-insights.com; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://*.vercel-insights.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ],
      "source": "/(.*)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/(words\\.css|words\\.js|search\\.json)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/og/(.*)\\.png"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/fonts/(.*)"
    }
  ],
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- .",
  "outputDirectory": "public",
  "redirects": [
    {
      "destination": "/flashprove",
      "permanent": false,
      "source": "/system"
    },
    {
      "destination": "/flashprove",
      "permanent": false,
      "source": "/system.html"
    },
    {
      "destination": "/checks",
      "permanent": false,
      "source": "/criteria"
    },
    {
      "destination": "/",
      "permanent": false,
      "source": "/deepprove"
    },
    {
      "destination": "/",
      "permanent": false,
      "source": "/reference"
    },
    {
      "destination": "/",
      "permanent": false,
      "source": "/release"
    },
    {
      "destination": "/",
      "permanent": false,
      "source": "/sash"
    },
    {
      "destination": "/",
      "permanent": false,
      "source": "/targets"
    },
    {
      "destination": "/og/icon-32.png",
      "permanent": false,
      "source": "/favicon.ico"
    }
  ],
  "trailingSlash": false
}
