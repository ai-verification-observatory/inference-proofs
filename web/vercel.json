{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "rm -rf public && mkdir -p public/og public/fonts && cp *.html words.css words.js public/ && cp og/*.png og/*.svg public/og/ && cp fonts/*.woff2 public/fonts/",
  "cleanUrls": true,
  "framework": null,
  "headers": [
    {
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-mkccg1Bdzxzb88nCf3H1COF45xcv9Y847Oe4O41BR1E='; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ],
      "source": "/(.*)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/(words\\.css|words\\.js)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/og/(.*)\\.png"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/fonts/(.*)"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "outputDirectory": "public",
  "redirects": [
    {
      "destination": "/flashprove",
      "permanent": true,
      "source": "/system"
    },
    {
      "destination": "/flashprove",
      "permanent": true,
      "source": "/system.html"
    }
  ],
  "trailingSlash": false
}
