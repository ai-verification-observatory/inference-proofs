{
  "$defs": {
    "commandLine": {
      "$comment": "one line of /io/commands.jsonl (RFC-0005 §Command log)",
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "cwd": {
          "minLength": 1,
          "type": "string"
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "started_mono_ns": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "argv",
        "cwd",
        "started_mono_ns",
        "exit_code"
      ],
      "type": "object"
    },
    "proof": {
      "additionalProperties": false,
      "properties": {
        "claimed_output": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "parts": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "proof_id": {
          "$ref": "../quantity/1.schema.json#/$defs/proofId"
        },
        "request_index": {
          "minimum": 0,
          "type": "integer"
        },
        "tokens_covered": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "proof_id",
        "request_index",
        "parts",
        "claimed_output"
      ],
      "type": "object"
    }
  },
  "$id": "https://inference-proofs.org/schema/adapter-out/1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "subcommand": {
            "const": "info"
          }
        }
      },
      "then": {
        "properties": {
          "binding_report": false,
          "commitment_id": false,
          "log_files": false,
          "logprobs_files": false,
          "mutated": false,
          "perturbation": false,
          "policy": false,
          "proofs": false,
          "prover_files": false,
          "raw_exit_code": false,
          "raw_last_line": false,
          "ready": false,
          "seconds": false,
          "sizes": false,
          "verdict": false,
          "verifier_files": false
        },
        "required": [
          "system",
          "upstream_commit",
          "image_inputs",
          "workloads",
          "profile",
          "contract_versions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "subcommand": {
            "const": "setup"
          }
        }
      },
      "then": {
        "properties": {
          "binding_report": false,
          "commitment_id": false,
          "contract_versions": false,
          "image_inputs": false,
          "logprobs_files": false,
          "mutated": false,
          "optional_subcommands": false,
          "perturbation": false,
          "policy": false,
          "profile": false,
          "proofs": false,
          "prover_files": false,
          "raw_exit_code": false,
          "raw_last_line": false,
          "seconds": false,
          "sizes": false,
          "system": false,
          "upstream_commit": false,
          "verdict": false,
          "verifier_files": false,
          "workloads": false
        },
        "required": [
          "ready",
          "log_files"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "subcommand": {
            "const": "commit"
          }
        }
      },
      "then": {
        "properties": {
          "binding_report": false,
          "contract_versions": false,
          "image_inputs": false,
          "log_files": false,
          "logprobs_files": false,
          "mutated": false,
          "optional_subcommands": false,
          "perturbation": false,
          "policy": false,
          "profile": false,
          "proofs": false,
          "raw_exit_code": false,
          "raw_last_line": false,
          "ready": false,
          "seconds": false,
          "system": false,
          "upstream_commit": false,
          "verdict": false,
          "workloads": false
        },
        "required": [
          "commitment_id",
          "verifier_files",
          "prover_files",
          "sizes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "subcommand": {
            "const": "prove"
          }
        }
      },
      "then": {
        "properties": {
          "commitment_id": false,
          "contract_versions": false,
          "image_inputs": false,
          "log_files": false,
          "logprobs_files": false,
          "mutated": false,
          "optional_subcommands": false,
          "perturbation": false,
          "policy": false,
          "profile": false,
          "prover_files": false,
          "raw_exit_code": false,
          "raw_last_line": false,
          "ready": false,
          "seconds": false,
          "sizes": false,
          "system": false,
          "upstream_commit": false,
          "verdict": false,
          "verifier_files": false,
          "workloads": false
        },
        "required": [
          "proofs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "subcommand": {
            "const": "verify"
          }
        }
      },
      "then": {
        "properties": {
          "binding_report": false,
          "commitment_id": false,
          "contract_versions": false,
          "image_inputs": false,
          "log_files": false,
          "logprobs_files": false,
          "mutated": false,
          "optional_subcommands": false,
          "perturbation": false,
          "profile": false,
          "proofs": false,
          "prover_files": false,
          "ready": false,
          "sizes": false,
          "system": false,
          "upstream_commit": false,
          "verifier_files": false,
          "workloads": false
        },
        "required": [
          "verdict",
          "raw_exit_code",
          "raw_last_line",
          "seconds"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "subcommand": {
            "const": "logprobs"
          }
        }
      },
      "then": {
        "properties": {
          "adapter_commit": false,
          "adapter_dirty": false,
          "binding_report": false,
          "commitment_id": false,
          "contract_versions": false,
          "image_inputs": false,
          "log_files": false,
          "mutated": false,
          "optional_subcommands": false,
          "perturbation": false,
          "policy": false,
          "profile": false,
          "proofs": false,
          "prover_files": false,
          "raw_exit_code": false,
          "raw_last_line": false,
          "ready": false,
          "seconds": false,
          "sizes": false,
          "system": false,
          "upstream_commit": false,
          "verdict": false,
          "verifier_files": false,
          "workloads": false
        },
        "required": [
          "logprobs_files"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "subcommand": {
            "const": "perturb"
          }
        }
      },
      "then": {
        "properties": {
          "adapter_commit": false,
          "adapter_dirty": false,
          "binding_report": false,
          "commitment_id": false,
          "contract_versions": false,
          "image_inputs": false,
          "log_files": false,
          "logprobs_files": false,
          "mutated": false,
          "optional_subcommands": false,
          "policy": false,
          "profile": false,
          "proofs": false,
          "prover_files": false,
          "raw_exit_code": false,
          "raw_last_line": false,
          "ready": false,
          "seconds": false,
          "sizes": false,
          "system": false,
          "upstream_commit": false,
          "verdict": false,
          "verifier_files": false,
          "workloads": false
        },
        "required": [
          "perturbation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "subcommand": {
            "const": "mutate_reply"
          }
        }
      },
      "then": {
        "properties": {
          "adapter_commit": false,
          "adapter_dirty": false,
          "binding_report": false,
          "commitment_id": false,
          "contract_versions": false,
          "image_inputs": false,
          "log_files": false,
          "logprobs_files": false,
          "optional_subcommands": false,
          "perturbation": false,
          "policy": false,
          "profile": false,
          "proofs": false,
          "prover_files": false,
          "raw_exit_code": false,
          "raw_last_line": false,
          "ready": false,
          "seconds": false,
          "sizes": false,
          "system": false,
          "upstream_commit": false,
          "verdict": false,
          "verifier_files": false,
          "workloads": false
        },
        "required": [
          "mutated"
        ]
      }
    }
  ],
  "properties": {
    "adapter_commit": {
      "$comment": "info: this repository's commit the image was built from (RFC-0014 B6); unknown when not baked in",
      "anyOf": [
        {
          "$ref": "../quantity/1.schema.json#/$defs/commit"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "adapter_dirty": {
      "$comment": "info: the image was built from a dirty tree (RFC-0014 B6)",
      "type": "boolean"
    },
    "binding_report": {
      "pattern": "^/io/[^\\x00]+$",
      "type": "string"
    },
    "commitment_id": {
      "minLength": 1,
      "type": "string"
    },
    "contract": {
      "const": "adapter/1"
    },
    "contract_versions": {
      "items": {
        "pattern": "^adapter/[1-9][0-9]*$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "image_inputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "$ref": "../quantity/1.schema.json#/$defs/digest"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "name",
          "url",
          "digest"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "log_files": {
      "items": {
        "pattern": "^/io/[^\\x00]+$",
        "type": "string"
      },
      "type": "array"
    },
    "logprobs_files": {
      "$comment": "logprobs (RFC-0018 AD-2): per text, in order, a file of float32 little-endian log-probabilities of each next token",
      "items": {
        "pattern": "^/io/logprobs/[^\\x00]+$",
        "type": "string"
      },
      "type": "array"
    },
    "mutated": {
      "$comment": "mutate_reply (RFC-0018 AD-6): what the adapter changed; the mutated proof is in out_dir",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "parts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "parts",
        "fields"
      ],
      "type": "object"
    },
    "optional_subcommands": {
      "$comment": "info (RFC-0018 AD-2): the optional subcommands this adapter implements; one not listed is unsupported and never called",
      "items": {
        "enum": [
          "logprobs",
          "perturb",
          "mutate_reply"
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "perturbation": {
      "$comment": "RFC-0018 AD-5: the record the adapter's perturb returns",
      "additionalProperties": false,
      "properties": {
        "digest_tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "digest_w": {
          "minLength": 1,
          "type": "string"
        },
        "digest_w_prime": {
          "minLength": 1,
          "type": "string"
        },
        "index": {
          "minimum": 0,
          "type": "integer"
        },
        "new": {},
        "old": {},
        "tensor": {
          "minLength": 1,
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "tensor",
        "index",
        "old",
        "new",
        "unit",
        "digest_w",
        "digest_w_prime",
        "digest_tool"
      ],
      "type": "object"
    },
    "phases": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "type": "string"
          },
          "seconds": {
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "name",
          "seconds"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "policy": {
      "minLength": 1,
      "type": "string"
    },
    "profile": {
      "$ref": "../quantity/1.schema.json#/$defs/profileId"
    },
    "proofs": {
      "items": {
        "$ref": "#/$defs/proof"
      },
      "type": "array"
    },
    "prover_files": {
      "items": {
        "pattern": "^/io/state/[^\\x00]+$",
        "type": "string"
      },
      "type": "array"
    },
    "raw_exit_code": {
      "type": "integer"
    },
    "raw_last_line": {
      "maxLength": 4096,
      "type": "string"
    },
    "ready": {
      "const": true
    },
    "schema": {
      "const": "adapter-out/1"
    },
    "seconds": {
      "minimum": 0,
      "type": "number"
    },
    "sizes": {
      "additionalProperties": false,
      "properties": {
        "prover_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "verifier_bytes": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "verifier_bytes",
        "prover_bytes"
      ],
      "type": "object"
    },
    "subcommand": {
      "enum": [
        "info",
        "setup",
        "commit",
        "prove",
        "verify",
        "logprobs",
        "perturb",
        "mutate_reply"
      ]
    },
    "system": {
      "$ref": "../quantity/1.schema.json#/$defs/systemId"
    },
    "upstream_commit": {
      "$ref": "../quantity/1.schema.json#/$defs/commit"
    },
    "verdict": {
      "enum": [
        "accept",
        "reject",
        "no_verdict",
        "invalid_call"
      ]
    },
    "verifier_files": {
      "items": {
        "pattern": "^/io/state/[^\\x00]+$",
        "type": "string"
      },
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "workloads": {
      "items": {
        "$ref": "../quantity/1.schema.json#/$defs/workloadId"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "contract",
    "subcommand",
    "phases",
    "warnings"
  ],
  "title": "Adapter output file /io/out.json (RFC-0005 §Subcommands and file shapes)",
  "type": "object"
}
