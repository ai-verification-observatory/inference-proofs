{
  "$defs": {
    "check": {
      "enum": [
        "pass",
        "fail",
        "not_checked"
      ]
    }
  },
  "$id": "https://inference-proofs.org/schema/review/1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "if": {
    "properties": {
      "outcome": {
        "const": "approved"
      }
    },
    "required": [
      "outcome"
    ]
  },
  "properties": {
    "checks": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "$ref": "#/$defs/check"
        },
        "controls": {
          "$ref": "#/$defs/check"
        },
        "derived_numbers": {
          "$ref": "#/$defs/check"
        },
        "logs": {
          "$ref": "#/$defs/check"
        },
        "pins": {
          "$ref": "#/$defs/check"
        }
      },
      "required": [
        "configuration",
        "controls",
        "derived_numbers",
        "logs",
        "pins"
      ],
      "type": "object"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "objections": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "check": {
            "enum": [
              "pins",
              "configuration",
              "logs",
              "derived_numbers",
              "controls"
            ]
          },
          "issue": {
            "format": "uri",
            "type": "string"
          },
          "text": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "check",
          "issue",
          "text"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "outcome": {
      "enum": [
        "approved",
        "objected"
      ]
    },
    "reviewer": {
      "additionalProperties": false,
      "properties": {
        "handle": {
          "minLength": 1,
          "type": "string"
        },
        "organisation": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "handle",
        "organisation"
      ],
      "type": "object"
    },
    "run_id": {
      "$ref": "../quantity/1.schema.json#/$defs/runId"
    },
    "schema": {
      "const": "review/1"
    }
  },
  "required": [
    "checks",
    "date",
    "objections",
    "outcome",
    "reviewer",
    "run_id",
    "schema"
  ],
  "then": {
    "properties": {
      "checks": {
        "properties": {
          "configuration": {
            "const": "pass"
          },
          "controls": {
            "const": "pass"
          },
          "derived_numbers": {
            "const": "pass"
          },
          "logs": {
            "const": "pass"
          },
          "pins": {
            "const": "pass"
          }
        }
      }
    }
  },
  "title": "Peer review record (RFC-0007 \u00a7Review record)",
  "type": "object"
}
