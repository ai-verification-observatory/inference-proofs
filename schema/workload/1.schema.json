{
  "$id": "https://inference-proofs.org/schema/workload/1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "a closed workload fixes exactly one claim class (RFC-0003 §Divisions)",
      "else": {
        "not": {
          "required": [
            "claim_class"
          ]
        }
      },
      "if": {
        "properties": {
          "division": {
            "const": "closed"
          }
        }
      },
      "then": {
        "required": [
          "claim_class"
        ]
      }
    }
  ],
  "properties": {
    "claim_class": {
      "pattern": "^(next-token|greedy-continuation|segment-grid|other)/(exact-match|tolerance|other)/(committed-weights|public-weights|other)$",
      "type": "string"
    },
    "decoding": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "const": "greedy"
        }
      },
      "required": [
        "rule"
      ],
      "type": "object"
    },
    "division": {
      "enum": [
        "native",
        "closed",
        "open"
      ]
    },
    "id": {
      "$ref": "../quantity/1.schema.json#/$defs/workloadId"
    },
    "model": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "../quantity/1.schema.json#/$defs/digest"
        },
        "files": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "bytes": {
                "minimum": 0,
                "type": "integer"
              },
              "path": {
                "pattern": "^[^/][^\\t\\n]*$",
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "licence": {
          "additionalProperties": false,
          "properties": {
            "gated": {
              "type": "boolean"
            },
            "name": {
              "minLength": 1,
              "type": "string"
            },
            "url": {
              "format": "uri",
              "type": "string"
            }
          },
          "required": [
            "name",
            "url",
            "gated"
          ],
          "type": "object"
        },
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "active_per_token": {
              "minimum": 1,
              "type": "integer"
            },
            "source": {
              "format": "uri",
              "type": "string"
            },
            "total": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "total",
            "active_per_token",
            "source"
          ],
          "type": "object"
        },
        "revision": {
          "$ref": "../quantity/1.schema.json#/$defs/commit"
        },
        "source": {
          "additionalProperties": false,
          "allOf": [
            {
              "else": {
                "properties": {
                  "path": false
                }
              },
              "if": {
                "properties": {
                  "hub": {
                    "const": "repository"
                  }
                }
              },
              "then": {
                "required": [
                  "path"
                ]
              }
            }
          ],
          "properties": {
            "hub": {
              "$comment": "repository: toy test data inside this repository at `path`, pinned by `revision` (a commit of this repository); never real model weights (AGENTS.md rule 8)",
              "enum": [
                "huggingface",
                "repository"
              ]
            },
            "path": {
              "pattern": "^systems/[a-z][a-z0-9-]{1,31}/model$",
              "type": "string"
            },
            "repo": {
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
              "type": "string"
            }
          },
          "required": [
            "hub",
            "repo"
          ],
          "type": "object"
        },
        "tokenizer_file": {
          "minLength": 1,
          "type": "string"
        },
        "tokenizer_source": {
          "$comment": "the tokenizer file from a second pinned repository, when the weights' repository has none (RFC-0003 §Workload file); model.digest covers the weights only",
          "additionalProperties": false,
          "properties": {
            "file": {
              "additionalProperties": false,
              "properties": {
                "bytes": {
                  "minimum": 0,
                  "type": "integer"
                },
                "path": {
                  "pattern": "^[^/][^\\t\\n]*$",
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "path",
                "sha256",
                "bytes"
              ],
              "type": "object"
            },
            "hub": {
              "const": "huggingface"
            },
            "repo": {
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
              "type": "string"
            },
            "revision": {
              "$ref": "../quantity/1.schema.json#/$defs/commit"
            }
          },
          "required": [
            "hub",
            "repo",
            "revision",
            "file"
          ],
          "type": "object"
        },
        "vocab_size": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "source",
        "revision",
        "files",
        "digest",
        "licence",
        "parameters",
        "tokenizer_file",
        "vocab_size"
      ],
      "type": "object"
    },
    "notes": {
      "minLength": 1,
      "type": "string"
    },
    "phase": {
      "enum": [
        "prefill",
        "decode",
        "both"
      ]
    },
    "precision": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "proved": {
          "minLength": 1,
          "type": "string"
        },
        "served": {
          "minLength": 1,
          "type": "string"
        },
        "weight_bits": {
          "$comment": "RFC-0003 §Weight bits: bits per weight of the precision as proved, an asserted input of RFC-0004 D-SPAB-S. A stated basis types `bits` (WB-1); a file_size basis lists `files`, covers all weights, and the loader computes `bits` (WB-2), so it is not typed; a computed basis types the `bits` its `method` computes from the listed `files`, covers all active weights, and fetch-model recomputes it (WB-5)",
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "basis": {
                    "const": "file_size"
                  }
                }
              },
              "then": {
                "properties": {
                  "bits": false,
                  "covers": {
                    "const": "all"
                  },
                  "method": false
                },
                "required": [
                  "files"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "basis": {
                    "const": "computed"
                  }
                }
              },
              "then": {
                "properties": {
                  "covers": {
                    "const": "all"
                  }
                },
                "required": [
                  "bits",
                  "files",
                  "method"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "basis": {
                    "const": "stated"
                  }
                }
              },
              "then": {
                "properties": {
                  "files": false,
                  "method": false
                },
                "required": [
                  "bits"
                ]
              }
            }
          ],
          "properties": {
            "basis": {
              "enum": [
                "stated",
                "file_size",
                "computed"
              ]
            },
            "bits": {
              "exclusiveMinimum": 0,
              "maximum": 64,
              "type": "number"
            },
            "covers": {
              "enum": [
                "all",
                "part"
              ]
            },
            "files": {
              "items": {
                "pattern": "^[^/][^\\t\\n]*$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "method": {
              "$comment": "RFC-0003 WB-5: the computation's id and version",
              "enum": [
                "gguf-active-mean/1"
              ]
            },
            "note": {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            "source": {
              "format": "uri",
              "type": "string"
            }
          },
          "required": [
            "basis",
            "covers",
            "source"
          ],
          "type": "object"
        }
      },
      "required": [
        "served",
        "proved"
      ],
      "type": "object"
    },
    "prompts": {
      "additionalProperties": false,
      "properties": {
        "corpus_digest": {
          "$ref": "../quantity/1.schema.json#/$defs/digest"
        },
        "count": {
          "minimum": 1,
          "type": "integer"
        },
        "generator": {
          "$comment": "corpus-window/1 takes a seed per job (RFC-0003); beacon-window/1 is corpus-window/1 seeded by the level's beacon round, and `count` is the requests of one session slot (RFC-0018 PR-1, PR-3)",
          "enum": [
            "corpus-window/1",
            "beacon-window/1"
          ]
        },
        "length_rule": {
          "additionalProperties": false,
          "properties": {
            "prompt_tokens": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "prompt_tokens"
          ],
          "type": "object"
        }
      },
      "required": [
        "generator",
        "corpus_digest",
        "count",
        "length_rule"
      ],
      "type": "object"
    },
    "schema": {
      "const": "workload/1"
    },
    "shape": {
      "additionalProperties": false,
      "properties": {
        "batch_size": {
          "minimum": 1,
          "type": "integer"
        },
        "batches_per_session": {
          "minimum": 1,
          "type": "integer"
        },
        "context_window": {
          "minimum": 1,
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 1,
          "type": "integer"
        },
        "prompt_tokens": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "prompt_tokens",
        "output_tokens",
        "batch_size",
        "batches_per_session",
        "context_window"
      ],
      "type": "object"
    },
    "systems": {
      "items": {
        "$ref": "../quantity/1.schema.json#/$defs/systemId"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "version": {
      "$ref": "../quantity/1.schema.json#/$defs/workloadVersion"
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "division",
    "model",
    "precision",
    "prompts",
    "shape",
    "decoding",
    "phase",
    "systems"
  ],
  "title": "Workload: workloads/<id>.yaml (RFC-0003 §Workload file)",
  "type": "object"
}
