{
  "$id": "https://inference-proofs.org/schema/system/1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "INV-ADAPTER-10: no incremental release means steady is not observable",
      "if": {
        "properties": {
          "incremental_proofs": {
            "const": false
          }
        },
        "required": [
          "proofs"
        ]
      },
      "then": {
        "properties": {
          "proofs": {
            "properties": {
              "steady_boundary": {
                "const": "not_observable"
              }
            }
          }
        }
      }
    },
    {
      "$comment": "reference systems (RFC-0015) carry an engine and object workloads, and may pin their adapter image; others an upstream, an image and workload ids",
      "else": {
        "properties": {
          "engine": false,
          "reference_role": false,
          "workloads": {
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "upstream",
          "profile",
          "proofs"
        ]
      },
      "if": {
        "properties": {
          "kind": {
            "const": "reference"
          }
        }
      },
      "then": {
        "properties": {
          "upstream": false,
          "workloads": {
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "reference_role",
          "engine"
        ]
      }
    },
    {
      "$comment": "a prover pins its adapter image by digest; test systems are rebuilt in CI",
      "if": {
        "properties": {
          "kind": {
            "const": "prover"
          }
        }
      },
      "then": {
        "required": [
          "image"
        ]
      }
    },
    {
      "$comment": "RFC-0015 SRV-3, SRV-6: a production-serving entry names its load point and GPU count, substitutes no precision, and passes only the three allowlisted engine options",
      "else": {
        "properties": {
          "workloads": {
            "items": {
              "properties": {
                "batch_size": false,
                "batches_per_session_run": false,
                "gpus": false,
                "load_point": false
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "reference_role": {
            "const": "serve"
          }
        },
        "required": [
          "reference_role"
        ]
      },
      "then": {
        "properties": {
          "workloads": {
            "items": {
              "properties": {
                "engine_args": {
                  "items": {
                    "pattern": "^(--tensor-parallel-size|--max-model-len|--max-num-seqs|[1-9][0-9]*)$"
                  }
                },
                "precision_substitution": {
                  "type": "null"
                }
              },
              "required": [
                "load_point",
                "gpus"
              ]
            }
          }
        }
      }
    }
  ],
  "properties": {
    "contract": {
      "const": "adapter/1"
    },
    "deterministic_proofs": {
      "type": "boolean"
    },
    "engine": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "$comment": "RFC-0015 Q1: the engine's source commit at the pinned version (the image's VLLM_BUILD_COMMIT); a join key of D-OVERHEAD-S with the version (RFC-0004 INV-DERIVE-2 (e))",
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "image": {
          "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "image"
      ],
      "type": "object"
    },
    "forbidden_flags": {
      "items": {
        "pattern": "^-",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "image": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "../quantity/1.schema.json#/$defs/digest"
        },
        "repository": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "repository",
        "digest"
      ],
      "type": "object"
    },
    "incremental_proofs": {
      "type": "boolean"
    },
    "kind": {
      "enum": [
        "prover",
        "reference",
        "test"
      ]
    },
    "maintainers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "handle": {
            "minLength": 1,
            "type": "string"
          },
          "organisation": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "handle",
          "organisation"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "max_proof_bytes": {
      "maximum": 68719476736,
      "minimum": 1,
      "type": "integer"
    },
    "max_proof_parts": {
      "maximum": 10000,
      "minimum": 1,
      "type": "integer"
    },
    "name": {
      "$ref": "../quantity/1.schema.json#/$defs/systemId"
    },
    "p1_refusals": {
      "description": "RFC-0018 CH-1a: the prover's stop names that mean the weights are not the committed ones; a P1 prover_failed trial counts as refused only when its line names one",
      "additionalProperties": false,
      "properties": {
        "stops": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "source": {
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "stops",
        "source"
      ],
      "type": "object"
    },
    "profile": {
      "$ref": "../quantity/1.schema.json#/$defs/profileId"
    },
    "proofs": {
      "additionalProperties": false,
      "properties": {
        "granularity": {
          "enum": [
            "request",
            "sequence",
            "segment_grid"
          ]
        },
        "steady_approximate": {
          "type": "boolean"
        },
        "steady_boundary": {
          "enum": [
            "first_proof",
            "first_complete_sequence",
            "not_observable"
          ]
        },
        "tokens_covered": {
          "enum": [
            "window",
            "prompt_plus_output",
            "declared_per_proof"
          ]
        },
        "verify_reads": {
          "$comment": "RFC-0008 §Parts the verifier reads: the proof parts the adapter's verify step reads. \"all\" (also when absent): every part. Otherwise the parts read and each part not read with its reason; C5, C6 and C8 choose only among the parts read",
          "else": {
            "additionalProperties": false,
            "properties": {
              "not_read": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "part": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                      "type": "string"
                    },
                    "reason": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "part",
                    "reason"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              },
              "read": {
                "items": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              }
            },
            "required": [
              "read",
              "not_read"
            ],
            "type": "object"
          },
          "if": {
            "type": "string"
          },
          "then": {
            "const": "all"
          }
        }
      },
      "required": [
        "granularity",
        "tokens_covered",
        "steady_boundary",
        "steady_approximate"
      ],
      "type": "object"
    },
    "reference_role": {
      "enum": [
        "serve",
        "recompute",
        "fidelity"
      ]
    },
    "schema": {
      "const": "system/1"
    },
    "timeouts_s": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "info": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "prove": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "setup": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "verify": {
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "type": "object"
    },
    "upstream": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "$ref": "../quantity/1.schema.json#/$defs/commit"
        },
        "repo": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "type": "string"
        },
        "tag": {
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "url",
        "commit"
      ],
      "type": "object"
    },
    "workloads": {
      "items": {
        "anyOf": [
          {
            "$ref": "../quantity/1.schema.json#/$defs/workloadId"
          },
          {
            "additionalProperties": false,
            "if": {
              "properties": {
                "load_point": {
                  "const": "ladder"
                }
              },
              "required": [
                "load_point"
              ]
            },
            "properties": {
              "batch_size": {
                "$comment": "RFC-0015 SRV-1: the high-load batch (serve role, `high` only)",
                "minimum": 1,
                "type": "integer"
              },
              "batches_per_session_run": {
                "$comment": "RFC-0015 SRV-1: batches per session of a serving run, when it differs from the workload's; null until the first capture sets it",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "minimum": 1,
                    "type": "integer"
                  }
                ]
              },
              "engine_args": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "gpus": {
                "$comment": "RFC-0015 SRV-6: the serving profile's GPU count this entry runs on (serve role only)",
                "minimum": 1,
                "type": "integer"
              },
              "id": {
                "$ref": "../quantity/1.schema.json#/$defs/workloadId"
              },
              "load_point": {
                "$comment": "RFC-0015 SRV-1: the production-serving load point (serve role only); RFC-0018 CO-4: `ladder`, the level's concurrency ladder in one prove call",
                "enum": [
                  "matched",
                  "high",
                  "ladder"
                ]
              },
              "precision_substitution": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "reason": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "source": {
                        "format": "uri",
                        "type": "string"
                      }
                    },
                    "required": [
                      "reason",
                      "source"
                    ],
                    "type": "object"
                  }
                ]
              },
              "precision_used": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "id",
              "precision_used",
              "precision_substitution",
              "engine_args"
            ],
            "then": {
              "$comment": "RFC-0018 CO-4: a ladder entry takes its batches from the level file",
              "properties": {
                "batch_size": false,
                "batches_per_session_run": false
              }
            },
            "type": "object"
          }
        ]
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "name",
    "kind",
    "contract",
    "workloads",
    "deterministic_proofs",
    "incremental_proofs",
    "forbidden_flags"
  ],
  "title": "System manifest: systems/<name>/system.yaml (RFC-0005 §system.yaml, RFC-0015 §Reference systems)",
  "type": "object"
}
