{
  "$defs": {
    "adapterPhase": {
      "$comment": "INV-GRADE-2: adapter-reported, scope primitive",
      "allOf": [
        {
          "$ref": "#/$defs/reported"
        }
      ],
      "properties": {
        "grade": {
          "const": "measured"
        },
        "scope": {
          "const": "primitive"
        },
        "source": {
          "properties": {
            "kind": {
              "const": "adapter"
            }
          }
        }
      }
    },
    "asserted": {
      "$comment": "an asserted input copied from the workload record (RFC-0003 WB-4, RFC-0004 INV-DERIVE-3)",
      "allOf": [
        {
          "$ref": "#/$defs/reported"
        }
      ],
      "properties": {
        "grade": {
          "const": "asserted"
        },
        "scope": {
          "const": null
        },
        "source": {
          "properties": {
            "kind": {
              "const": "reference_file"
            }
          }
        }
      }
    },
    "failure": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "type": "string"
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "config",
            "environment",
            "integrity",
            "fetch",
            "adapter",
            "timeout",
            "resource",
            "policy",
            "internal"
          ]
        },
        "last_lines": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "type": "array"
        },
        "message": {
          "maxLength": 4096,
          "type": "string"
        },
        "step": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "step",
        "message",
        "exit_code",
        "last_lines",
        "at"
      ],
      "type": "object"
    },
    "quantities": {
      "additionalProperties": {
        "$ref": "#/$defs/reported"
      },
      "type": "object"
    },
    "reported": {
      "$comment": "INV-QTY-4: every quantity in run.json has tier reported",
      "allOf": [
        {
          "$ref": "../quantity/1.schema.json#/$defs/quantity"
        }
      ],
      "properties": {
        "tier": {
          "const": "reported"
        }
      }
    },
    "reportedValue": {
      "$comment": "INV-QTY-4",
      "oneOf": [
        {
          "$ref": "../quantity/1.schema.json#/$defs/quantity"
        },
        {
          "$ref": "../quantity/1.schema.json#/$defs/statistic"
        }
      ],
      "properties": {
        "tier": {
          "const": "reported"
        }
      }
    }
  },
  "$id": "https://inference-proofs.org/schema/run/1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "failure is set exactly when status is failed",
      "else": {
        "properties": {
          "failure": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "failure": {
            "type": "object"
          }
        }
      }
    }
  ],
  "properties": {
    "adapter_phases": {
      "additionalProperties": {
        "$ref": "#/$defs/adapterPhase"
      },
      "type": "object"
    },
    "claim": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "card_version": {
              "minimum": 1,
              "type": "integer"
            },
            "configuration": {
              "$ref": "../quantity/1.schema.json#/$defs/configurationId"
            },
            "system": {
              "$ref": "../quantity/1.schema.json#/$defs/systemId"
            }
          },
          "required": [
            "system",
            "configuration",
            "card_version"
          ],
          "type": "object"
        }
      ]
    },
    "control": {
      "type": "boolean"
    },
    "events": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "event": {
            "pattern": "^[a-z][a-z0-9_.]*$",
            "type": "string"
          },
          "mono_ns": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "event",
          "mono_ns"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "failure": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/failure"
        }
      ]
    },
    "inputs": {
      "$comment": "RFC-0003 WB-4: the workload record's inputs to D-APT-S and D-SPAB-S at run time, so G4 recomputes from the run, not from the workload file at HEAD; RFC-0004 INV-DERIVE-8: the profile's GPU count, input of D-GSPT-S and D-COST-1K-S",
      "additionalProperties": false,
      "properties": {
        "active_parameters_per_token": {
          "allOf": [
            {
              "$ref": "#/$defs/asserted"
            }
          ],
          "properties": {
            "unit": {
              "const": "count"
            }
          }
        },
        "gpu_count": {
          "allOf": [
            {
              "$ref": "#/$defs/asserted"
            }
          ],
          "properties": {
            "unit": {
              "const": "count"
            },
            "value": {
              "minimum": 1
            }
          }
        },
        "weight_bits": {
          "allOf": [
            {
              "$ref": "#/$defs/asserted"
            }
          ],
          "properties": {
            "unit": {
              "const": "bit/weight"
            }
          }
        }
      },
      "required": [
        "active_parameters_per_token",
        "weight_bits"
      ],
      "type": "object"
    },
    "marks": {
      "$comment": "RFC-0018 AD-4: the generation marks the adapter renamed into /io/marks during prove, timed like proof releases; absent when it wrote none",
      "items": {
        "additionalProperties": false,
        "properties": {
          "mono_ns": {
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "enum": [
              "generation.start",
              "generation.end"
            ]
          }
        },
        "required": [
          "name",
          "mono_ns"
        ],
        "type": "object"
      },
      "type": "array",
      "uniqueItems": true
    },
    "metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/reportedValue"
      },
      "propertyNames": {
        "$ref": "../quantity/1.schema.json#/$defs/metricId"
      },
      "type": "object"
    },
    "profile": {
      "$ref": "../quantity/1.schema.json#/$defs/profileId"
    },
    "proofs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "agreement": {
            "$comment": "ref-recompute only (RFC-0015 RC-3, RC-5): positions of the source run's claimed output that the teacher-forced argmax matches",
            "additionalProperties": false,
            "properties": {
              "agree": {
                "minimum": 0,
                "type": "integer"
              },
              "disagree": {
                "minimum": 0,
                "type": "integer"
              },
              "first_disagreement": {
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "required": [
              "agree",
              "disagree",
              "first_disagreement"
            ],
            "type": "object"
          },
          "claimed_output": {
            "$comment": "token ids the system claims for that request; a later ref-recompute run checks them (RFC-0015 RC-1)",
            "items": {
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "claimed_tokens": {
            "$comment": "a serving ladder run: the count of claimed_output's token ids, which are in the run's replies file (iproofs.replies)",
            "minimum": 0,
            "type": "integer"
          },
          "proof_id": {
            "$ref": "../quantity/1.schema.json#/$defs/proofId"
          },
          "release_mono_ns": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "request_index": {
            "$comment": "the request the proof or output answers (RFC-0005 out.json)",
            "minimum": 0,
            "type": "integer"
          },
          "tokens_covered": {
            "minimum": 0,
            "type": "integer"
          },
          "verdict": {
            "enum": [
              null,
              "accept",
              "reject",
              "no_verdict",
              "invalid_call"
            ]
          }
        },
        "required": [
          "proof_id",
          "release_mono_ns",
          "tokens_covered",
          "verdict"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "raw": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "$ref": "#/$defs/quantities"
        },
        "info": {
          "$ref": "#/$defs/quantities"
        },
        "prove": {
          "$ref": "#/$defs/quantities"
        },
        "setup": {
          "$ref": "#/$defs/quantities"
        },
        "verify": {
          "$ref": "#/$defs/quantities"
        }
      },
      "type": "object"
    },
    "release": {
      "$ref": "../quantity/1.schema.json#/$defs/releaseId"
    },
    "repetition": {
      "minimum": 1,
      "type": "integer"
    },
    "replaces": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            "run_id": {
              "$ref": "../quantity/1.schema.json#/$defs/runId"
            }
          },
          "required": [
            "run_id",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "replies": {
      "$comment": "a serving ladder run: the file beside run.json that holds every output's claimed_output, by digest; kept with the run in the bucket, not in git (RFC-0013 SIZE-1)",
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "file": {
          "const": "replies.jsonl"
        },
        "outputs": {
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "file",
        "sha256",
        "bytes",
        "outputs"
      ],
      "type": "object"
    },
    "run_id": {
      "$ref": "../quantity/1.schema.json#/$defs/runId"
    },
    "schema": {
      "const": "run/1"
    },
    "status": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "system": {
      "$ref": "../quantity/1.schema.json#/$defs/systemId"
    },
    "system_kind": {
      "enum": [
        "prover",
        "reference",
        "test"
      ]
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "workload": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "../quantity/1.schema.json#/$defs/workloadId"
        },
        "version": {
          "$ref": "../quantity/1.schema.json#/$defs/workloadVersion"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema",
    "run_id",
    "release",
    "system",
    "workload",
    "profile",
    "repetition",
    "control",
    "system_kind",
    "claim",
    "status",
    "failure",
    "replaces",
    "raw",
    "adapter_phases",
    "metrics",
    "events",
    "proofs",
    "warnings"
  ],
  "title": "One job's record: results/<release>/<system>/<run-id>/run.json (RFC-0009 §Storage, RFC-0004)",
  "type": "object"
}
