{
  "$defs": {
    "cost": {
      "$comment": "RFC-0006 §Cost basis: one price basis (C2, C3); `cost` is the release's default basis, and a prover profile whose GPU model is priced apart names a basis of `costs` (C7)",
      "additionalProperties": false,
      "properties": {
        "basis": {
          "minLength": 1,
          "type": "string"
        },
        "date": {
          "format": "date",
          "type": "string"
        },
        "not_priced": {
          "items": {
            "enum": [
              "gpu",
              "cpu",
              "host_memory",
              "disk",
              "network"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "price_per_gpu_hour_usd": {
          "allOf": [
            {
              "$ref": "../quantity/1.schema.json#/$defs/quantity"
            }
          ],
          "properties": {
            "grade": {
              "const": "asserted"
            },
            "scope": {
              "type": "null"
            },
            "unit": {
              "const": "USD/gpu_hour"
            }
          }
        },
        "priced": {
          "items": {
            "enum": [
              "gpu",
              "cpu",
              "host_memory",
              "disk",
              "network"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "providers": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "readings": {
          "$comment": "RFC-0006 C3: the archived price readings; the validator recomputes the median (COST-1)",
          "items": {
            "additionalProperties": false,
            "properties": {
              "gpus": {
                "minimum": 1,
                "type": "integer"
              },
              "list_price_usd_per_hour": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "offer": {
                "minLength": 1,
                "type": "string"
              },
              "provider": {
                "minLength": 1,
                "type": "string"
              },
              "url": {
                "format": "uri",
                "type": "string"
              }
            },
            "required": [
              "provider",
              "url",
              "offer",
              "list_price_usd_per_hour",
              "gpus"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "price_per_gpu_hour_usd",
        "basis",
        "providers",
        "date",
        "priced",
        "not_priced"
      ],
      "type": "object"
    },
    "gpu": {
      "$comment": "the GPUs a job binds and its cost counts (RFC-0006 R1, R6)",
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 1,
          "type": "integer"
        },
        "form_factor": {
          "minLength": 1,
          "type": "string"
        },
        "memory_mib_min": {
          "minimum": 1,
          "type": "integer"
        },
        "model": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "model",
        "form_factor",
        "count",
        "memory_mib_min"
      ],
      "type": "object"
    },
    "prover": {
      "additionalProperties": false,
      "properties": {
        "container_runtime": {
          "$comment": "RFC-0006: docker on the host (anyOf/0), or a hosted container the provider starts from the adapter image, with the harness inside it (anyOf/1, §Hosted execution)",
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "cgroup_driver": {
                  "enum": [
                    "systemd",
                    "cgroupfs"
                  ]
                },
                "docker_engine_min": {
                  "pattern": "^[0-9]+(\\.[0-9]+)*$",
                  "type": "string"
                },
                "nvidia_container_toolkit_min": {
                  "pattern": "^[0-9]+(\\.[0-9]+)*$",
                  "type": "string"
                }
              },
              "required": [
                "docker_engine_min",
                "nvidia_container_toolkit_min",
                "cgroup_driver"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "cgroup_version": {
                  "const": "2"
                },
                "kind": {
                  "const": "hosted"
                }
              },
              "required": [
                "kind",
                "cgroup_version"
              ],
              "type": "object"
            }
          ]
        },
        "cost": {
          "$comment": "RFC-0006 C7: the basis in `costs` that prices this profile's GPU; absent, the profile uses `cost`",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "type": "string"
        },
        "cpu": {
          "additionalProperties": false,
          "properties": {
            "logical_cpus_on_gpu_numa_node": {
              "minimum": 1,
              "type": "integer"
            },
            "logical_cpus_total_min": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "logical_cpus_on_gpu_numa_node",
            "logical_cpus_total_min"
          ],
          "type": "object"
        },
        "disk": {
          "additionalProperties": false,
          "properties": {
            "free_gib_min": {
              "minimum": 1,
              "type": "integer"
            },
            "type": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "type",
            "free_gib_min"
          ],
          "type": "object"
        },
        "driver": {
          "minLength": 1,
          "type": "string"
        },
        "gpu": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$comment": "RFC-0006 R1: a prover profile binds one GPU",
              "allOf": [
                {
                  "$ref": "#/$defs/gpu"
                }
              ],
              "properties": {
                "count": {
                  "maximum": 1
                }
              }
            }
          ]
        },
        "host_memory_gib_min": {
          "minimum": 1,
          "type": "integer"
        },
        "kernel_min": {
          "pattern": "^[0-9]+(\\.[0-9]+)*$",
          "type": "string"
        },
        "kind": {
          "const": "prover"
        },
        "os": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "version_id": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "id",
            "version_id"
          ],
          "type": "object"
        }
      },
      "required": [
        "kind",
        "gpu",
        "cpu",
        "host_memory_gib_min",
        "disk",
        "os",
        "kernel_min",
        "driver",
        "container_runtime"
      ],
      "type": "object"
    },
    "serving": {
      "additionalProperties": false,
      "properties": {
        "container_runtime": {
          "$comment": "RFC-0006: docker on the host (anyOf/0), or a hosted container the provider starts from the adapter image, with the harness inside it (anyOf/1, §Hosted execution)",
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "cgroup_driver": {
                  "enum": [
                    "systemd",
                    "cgroupfs"
                  ]
                },
                "docker_engine_min": {
                  "pattern": "^[0-9]+(\\.[0-9]+)*$",
                  "type": "string"
                },
                "nvidia_container_toolkit_min": {
                  "pattern": "^[0-9]+(\\.[0-9]+)*$",
                  "type": "string"
                }
              },
              "required": [
                "docker_engine_min",
                "nvidia_container_toolkit_min",
                "cgroup_driver"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "cgroup_version": {
                  "const": "2"
                },
                "kind": {
                  "const": "hosted"
                }
              },
              "required": [
                "kind",
                "cgroup_version"
              ],
              "type": "object"
            }
          ]
        },
        "cost": {
          "$comment": "RFC-0006 C7: the basis in `costs` that prices this profile's GPU; absent, the profile uses `cost`",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "type": "string"
        },
        "cpu": {
          "additionalProperties": false,
          "properties": {
            "logical_cpus_on_gpu_numa_node": {
              "minimum": 1,
              "type": "integer"
            },
            "logical_cpus_total_min": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "logical_cpus_on_gpu_numa_node",
            "logical_cpus_total_min"
          ],
          "type": "object"
        },
        "disk": {
          "additionalProperties": false,
          "properties": {
            "free_gib_min": {
              "minimum": 1,
              "type": "integer"
            },
            "type": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "type",
            "free_gib_min"
          ],
          "type": "object"
        },
        "driver": {
          "minLength": 1,
          "type": "string"
        },
        "gpu": {
          "$comment": "RFC-0006 R6: a serving profile always names its GPUs; its count is part of the profile",
          "$ref": "#/$defs/gpu"
        },
        "host_memory_gib_min": {
          "minimum": 1,
          "type": "integer"
        },
        "kernel_min": {
          "pattern": "^[0-9]+(\\.[0-9]+)*$",
          "type": "string"
        },
        "kind": {
          "const": "serving"
        },
        "os": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "version_id": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "id",
            "version_id"
          ],
          "type": "object"
        },
        "pairs_with": {
          "$comment": "RFC-0006 R6: the prover profiles whose rows this profile's rows may be divided against (same GPU model, form factor and runtime kind, checked by the validator)",
          "items": {
            "$ref": "../quantity/1.schema.json#/$defs/profileId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "shm_gib_min": {
          "$comment": "RFC-0006 PC-SHM: the /dev/shm size a hosted serving container needs",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "gpu",
        "cpu",
        "host_memory_gib_min",
        "disk",
        "os",
        "kernel_min",
        "driver",
        "container_runtime",
        "pairs_with"
      ],
      "type": "object"
    },
    "verifier": {
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "additionalProperties": false,
          "properties": {
            "logical_cpus": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "logical_cpus"
          ],
          "type": "object"
        },
        "emulation": {
          "additionalProperties": false,
          "properties": {
            "allowed_on": {
              "items": {
                "$ref": "../quantity/1.schema.json#/$defs/profileId"
              },
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "allowed_on"
          ],
          "type": "object"
        },
        "gpu": {
          "type": "null"
        },
        "host_memory_gib": {
          "minimum": 1,
          "type": "integer"
        },
        "kind": {
          "const": "verifier"
        }
      },
      "required": [
        "kind",
        "gpu",
        "cpu",
        "host_memory_gib",
        "emulation"
      ],
      "type": "object"
    }
  },
  "$id": "https://inference-proofs.org/schema/reference/1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cost": {
      "$ref": "#/$defs/cost"
    },
    "costs": {
      "$comment": "RFC-0006 C7: further price bases, one per GPU model priced apart from `cost`, named by a prover profile's `cost`",
      "additionalProperties": {
        "$ref": "#/$defs/cost"
      },
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "type": "object"
    },
    "profiles": {
      "additionalProperties": {
        "else": {
          "else": {
            "$ref": "#/$defs/verifier"
          },
          "if": {
            "properties": {
              "kind": {
                "const": "serving"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/serving"
          }
        },
        "if": {
          "properties": {
            "kind": {
              "const": "prover"
            }
          }
        },
        "properties": {
          "kind": {
            "enum": [
              "prover",
              "serving",
              "verifier"
            ]
          }
        },
        "required": [
          "kind"
        ],
        "then": {
          "$ref": "#/$defs/prover"
        },
        "type": "object"
      },
      "minProperties": 1,
      "propertyNames": {
        "$ref": "../quantity/1.schema.json#/$defs/profileId"
      },
      "type": "object"
    },
    "release": {
      "anyOf": [
        {
          "$ref": "../quantity/1.schema.json#/$defs/releaseId"
        },
        {
          "const": "ci"
        }
      ]
    },
    "schema": {
      "const": "reference/1"
    }
  },
  "required": [
    "schema",
    "release",
    "profiles",
    "cost"
  ],
  "title": "Reference profiles and cost basis: reference/<release>.yaml (RFC-0006 §Reference file)",
  "type": "object"
}
