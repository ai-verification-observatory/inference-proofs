{
  "$defs": {
    "file": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "digest": {
          "$ref": "../quantity/1.schema.json#/$defs/digest"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "digest",
        "bytes"
      ],
      "type": "object"
    },
    "machine": {
      "$comment": "RFC-0006 §Machine record: exactly these fields (INV-MR-1); a field the host cannot probe is absent",
      "additionalProperties": false,
      "properties": {
        "container": {
          "additionalProperties": false,
          "properties": {
            "cgroup_driver": {
              "minLength": 1,
              "type": "string"
            },
            "cgroup_version": {
              "minLength": 1,
              "type": "string"
            },
            "docker_engine": {
              "minLength": 1,
              "type": "string"
            },
            "execution": {
              "enum": [
                "docker",
                "hosted"
              ]
            },
            "nvidia_container_toolkit": {
              "minLength": 1,
              "type": "string"
            },
            "shm_bytes": {
              "$comment": "RFC-0006 PC-SHM: statvfs of /dev/shm",
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "cpu": {
          "additionalProperties": false,
          "properties": {
            "bound_prover": {
              "items": {
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "bound_verifier": {
              "items": {
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "bound_verifier_single": {
              "items": {
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "cgroup_quota_cpus": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "logical_cpus": {
              "minimum": 0,
              "type": "integer"
            },
            "model": {
              "minLength": 1,
              "type": "string"
            },
            "physical_cores": {
              "minimum": 0,
              "type": "integer"
            },
            "smt_active": {
              "type": "boolean"
            },
            "sockets": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "disk": {
          "additionalProperties": false,
          "properties": {
            "free_bytes_at_start": {
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "enum": [
                "nvme",
                "ssd",
                "hdd"
              ]
            }
          },
          "type": "object"
        },
        "gpu": {
          "additionalProperties": false,
          "properties": {
            "bound_index": {
              "minimum": 0,
              "type": "integer"
            },
            "bound_indices": {
              "$comment": "RFC-0006 R6: every bound GPU; bound_index is the first",
              "items": {
                "minimum": 0,
                "type": "integer"
              },
              "minItems": 1,
              "type": "array"
            },
            "count_visible": {
              "minimum": 0,
              "type": "integer"
            },
            "cuda_driver_api": {
              "minLength": 1,
              "type": "string"
            },
            "driver_version": {
              "minLength": 1,
              "type": "string"
            },
            "memory_total_mib": {
              "minimum": 0,
              "type": "integer"
            },
            "model": {
              "minLength": 1,
              "type": "string"
            },
            "numa_node": {
              "minimum": -1,
              "type": "integer"
            },
            "numa_nodes": {
              "$comment": "RFC-0006: the NUMA node of each bound GPU",
              "items": {
                "minimum": -1,
                "type": "integer"
              },
              "type": "array"
            },
            "nvlink_active_links": {
              "$comment": "RFC-0006 PC-GPU-LINK (record only): active NVLink links per bound GPU, null where NVML does not report it",
              "items": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "minimum": 0,
                    "type": "integer"
                  }
                ]
              },
              "type": "array"
            },
            "unbound_samples": {
              "$comment": "RFC-0006 PC-GPU-IDLE: per visible unbound GPU, the maxima over the job's samples",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "compute_processes_max": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "index": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "memory_used_mib_max": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "samples": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "util_percent_max": {
                    "maximum": 100,
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "required": [
                  "index",
                  "samples",
                  "compute_processes_max",
                  "memory_used_mib_max",
                  "util_percent_max"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "kernel": {
          "additionalProperties": false,
          "properties": {
            "release": {
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        },
        "memory": {
          "additionalProperties": false,
          "properties": {
            "available_bytes_at_start": {
              "minimum": 0,
              "type": "integer"
            },
            "cgroup_limit_bytes": {
              "minimum": 0,
              "type": "integer"
            },
            "total_bytes": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "numa": {
          "additionalProperties": false,
          "properties": {
            "bound_mems": {
              "items": {
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "nodes": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "os": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "version_id": {
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        },
        "provider": {
          "minLength": 1,
          "type": "string"
        },
        "verifier_host": {
          "enum": [
            "same_as_prover",
            "separate"
          ]
        }
      },
      "type": "object"
    }
  },
  "$id": "https://inference-proofs.org/schema/manifest/1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "card_version": {
              "minimum": 1,
              "type": "integer"
            },
            "configuration": {
              "$ref": "../quantity/1.schema.json#/$defs/configurationId"
            },
            "system": {
              "$ref": "../quantity/1.schema.json#/$defs/systemId"
            }
          },
          "required": [
            "system",
            "configuration",
            "card_version"
          ],
          "type": "object"
        }
      ]
    },
    "commands": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "argv": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "cpuset": {
            "pattern": "^[0-9,-]+$",
            "type": "string"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "gpus": {
            "type": [
              "string",
              "null"
            ]
          },
          "mems": {
            "pattern": "^[0-9,-]+$",
            "type": "string"
          },
          "network": {
            "$comment": "none: docker --network none; provider: a hosted container keeps the provider's network (RFC-0006 §Hosted execution)",
            "enum": [
              "none",
              "provider"
            ]
          },
          "started_at": {
            "format": "date-time",
            "type": "string"
          },
          "step": {
            "enum": [
              "info",
              "setup",
              "commit",
              "prove",
              "verify",
              "control"
            ]
          }
        },
        "required": [
          "step",
          "argv",
          "cpuset",
          "mems",
          "gpus",
          "network",
          "started_at",
          "exit_code"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "commitment": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "commitment_id": {
              "minLength": 1,
              "type": "string"
            },
            "prover_files": {
              "items": {
                "$ref": "#/$defs/file"
              },
              "type": "array"
            },
            "verifier_files": {
              "items": {
                "$ref": "#/$defs/file"
              },
              "type": "array"
            }
          },
          "required": [
            "commitment_id",
            "verifier_files",
            "prover_files"
          ],
          "type": "object"
        }
      ]
    },
    "control": {
      "type": "boolean"
    },
    "engine": {
      "$comment": "RFC-0015 SRV-3, SRV-6: the production-serving engine as the run's system.yaml pins it, and the interface the adapter built it in; the image digest is a join key of D-OVERHEAD-S (RFC-0004 INV-DERIVE-2 (e))",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "image": {
              "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "interface": {
              "enum": [
                "vllm serve",
                "LLM class"
              ]
            },
            "name": {
              "minLength": 1,
              "type": "string"
            },
            "observed": {
              "$comment": "RFC-0004 INV-DERIVE-2 (e): the engine as the adapter saw it run, from its recorded command: the installed version, the image ENV's build commit, and the batched-token limit the engine logged (null where it logged none)",
              "additionalProperties": false,
              "properties": {
                "build_commit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "max_num_batched_tokens": {
                  "minimum": 1,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "version": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "version",
                "build_commit",
                "max_num_batched_tokens"
              ],
              "type": "object"
            },
            "version": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "name",
            "version",
            "image",
            "interface"
          ],
          "type": "object"
        }
      ]
    },
    "harness": {
      "additionalProperties": false,
      "properties": {
        "git_commit": {
          "$ref": "../quantity/1.schema.json#/$defs/commit"
        },
        "git_dirty": {
          "type": "boolean"
        },
        "lock_digest": {
          "$ref": "../quantity/1.schema.json#/$defs/digest"
        },
        "nonconforming": {
          "type": "boolean"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "version",
        "git_commit",
        "git_dirty",
        "lock_digest",
        "nonconforming"
      ],
      "type": "object"
    },
    "machine": {
      "$ref": "#/$defs/machine"
    },
    "machine_verifier": {
      "$comment": "present when verifier_host is separate (RFC-0006)",
      "$ref": "#/$defs/machine"
    },
    "profile": {
      "additionalProperties": false,
      "properties": {
        "prover": {
          "$ref": "../quantity/1.schema.json#/$defs/profileId"
        },
        "reference_digest": {
          "$ref": "../quantity/1.schema.json#/$defs/digest"
        },
        "reference_file": {
          "pattern": "^reference/[a-z0-9.-]+\\.yaml$",
          "type": "string"
        },
        "verifier": {
          "$ref": "../quantity/1.schema.json#/$defs/profileId"
        },
        "verifier_host": {
          "enum": [
            "same_as_prover",
            "separate"
          ]
        }
      },
      "required": [
        "prover",
        "verifier",
        "verifier_host",
        "reference_file",
        "reference_digest"
      ],
      "type": "object"
    },
    "prompts_from": {
      "$comment": "the run whose prompt seeds this job replayed (--prompts-from, RFC-0015 RC-1); null for a fresh seed",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "../quantity/1.schema.json#/$defs/runId"
        }
      ]
    },
    "proofs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "archive": {
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "digest": {
            "$ref": "../quantity/1.schema.json#/$defs/digest"
          },
          "parts": {
            "items": {
              "$ref": "#/$defs/file"
            },
            "minItems": 1,
            "type": "array"
          },
          "proof_id": {
            "$ref": "../quantity/1.schema.json#/$defs/proofId"
          }
        },
        "required": [
          "proof_id",
          "digest",
          "parts",
          "archive"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "provider": {
      "minLength": 1,
      "type": "string"
    },
    "release": {
      "$ref": "../quantity/1.schema.json#/$defs/releaseId"
    },
    "run_id": {
      "$ref": "../quantity/1.schema.json#/$defs/runId"
    },
    "runner": {
      "additionalProperties": false,
      "properties": {
        "affiliated_systems": {
          "items": {
            "$ref": "../quantity/1.schema.json#/$defs/systemId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "handle": {
          "minLength": 1,
          "type": "string"
        },
        "organisation": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "handle",
        "organisation",
        "affiliated_systems"
      ],
      "type": "object"
    },
    "schema": {
      "const": "manifest/1"
    },
    "self_test": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "pattern": "^ST-[A-Z0-9-]+$",
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "passed"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "passed",
        "checks"
      ],
      "type": "object"
    },
    "serving_model": {
      "$comment": "RFC-0015 SRV-6: the serving record whose files the run served; `digest` is a join key of D-OVERHEAD-S, id and version are for display",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "$ref": "../quantity/1.schema.json#/$defs/digest"
            },
            "id": {
              "pattern": "^[a-z0-9][a-z0-9.-]{0,95}$",
              "type": "string"
            },
            "publisher": {
              "additionalProperties": false,
              "properties": {
                "repo": {
                  "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
                  "type": "string"
                },
                "revision": {
                  "$ref": "../quantity/1.schema.json#/$defs/commit"
                }
              },
              "required": [
                "repo",
                "revision"
              ],
              "type": "object"
            },
            "source": {
              "additionalProperties": false,
              "properties": {
                "repo": {
                  "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
                  "type": "string"
                },
                "revision": {
                  "$ref": "../quantity/1.schema.json#/$defs/commit"
                }
              },
              "required": [
                "repo",
                "revision"
              ],
              "type": "object"
            },
            "version": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "version",
            "digest",
            "source",
            "publisher"
          ],
          "type": "object"
        }
      ]
    },
    "system": {
      "additionalProperties": false,
      "properties": {
        "adapter_commit": {
          "$ref": "../quantity/1.schema.json#/$defs/commit"
        },
        "adapter_dirty": {
          "type": "boolean"
        },
        "claim_digest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "../quantity/1.schema.json#/$defs/digest"
            }
          ]
        },
        "image": {
          "additionalProperties": false,
          "properties": {
            "digest_kind": {
              "enum": [
                "manifest",
                "config"
              ]
            },
            "ref": {
              "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "ref",
            "digest_kind"
          ],
          "type": "object"
        },
        "image_inputs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "$ref": "../quantity/1.schema.json#/$defs/digest"
              },
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "url": {
                "format": "uri",
                "type": "string"
              }
            },
            "required": [
              "name",
              "url",
              "digest"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "name": {
          "$ref": "../quantity/1.schema.json#/$defs/systemId"
        },
        "system_manifest_digest": {
          "$ref": "../quantity/1.schema.json#/$defs/digest"
        },
        "upstream": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "additionalProperties": false,
              "properties": {
                "commit": {
                  "$ref": "../quantity/1.schema.json#/$defs/commit"
                },
                "repo": {
                  "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
                  "type": "string"
                }
              },
              "required": [
                "repo",
                "commit"
              ],
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "name",
        "system_manifest_digest",
        "claim_digest",
        "upstream",
        "adapter_commit",
        "adapter_dirty",
        "image",
        "image_inputs"
      ],
      "type": "object"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "workload": {
      "additionalProperties": false,
      "properties": {
        "batch_size_run": {
          "$comment": "RFC-0015 SRV-1: the batch size the run served, when it differs from the workload's",
          "minimum": 1,
          "type": "integer"
        },
        "batches_per_session_run": {
          "$comment": "RFC-0015 SRV-1: batches the run served",
          "minimum": 1,
          "type": "integer"
        },
        "corpus_digest": {
          "$ref": "../quantity/1.schema.json#/$defs/digest"
        },
        "file_digest": {
          "$ref": "../quantity/1.schema.json#/$defs/digest"
        },
        "id": {
          "$ref": "../quantity/1.schema.json#/$defs/workloadId"
        },
        "load_point": {
          "$comment": "RFC-0015 SRV-1: a production-serving run's load point",
          "enum": [
            "matched",
            "high"
          ]
        },
        "model": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "$ref": "../quantity/1.schema.json#/$defs/digest"
            },
            "revision": {
              "$ref": "../quantity/1.schema.json#/$defs/commit"
            },
            "source": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "source",
            "revision",
            "digest"
          ],
          "type": "object"
        },
        "prompt_count_run": {
          "$comment": "RFC-0015 SRV-8: prompts the run processed",
          "minimum": 1,
          "type": "integer"
        },
        "prompt_prefix_digest": {
          "$comment": "RFC-0015 SRV-8: digest of the first prompts.count prompts of an extended set; equal to the source run's prompt_set_digest",
          "$ref": "../quantity/1.schema.json#/$defs/digest"
        },
        "prompt_seed": {
          "pattern": "^0x[0-9a-f]{16}$",
          "type": "string"
        },
        "prompt_set_digest": {
          "$ref": "../quantity/1.schema.json#/$defs/digest"
        },
        "sizing_capture": {
          "$comment": "RFC-0015 SRV-1: a matched production-serving run of a declared sizing count of batches (`iproofs run --sizing-batches N`), made while the entry's batches_per_session_run is null so that `iproofs serving size-session` can size it; it joins no overhead (RFC-0004 INV-DERIVE-2)",
          "const": true
        },
        "steady_rule": {
          "$comment": "RFC-0004 INV-SCOPE-5: the steady-scope rule the run's steady figures follow; absent on runs recorded before 2026-11-09 (first-proof boundary)",
          "enum": [
            "batch-membership"
          ]
        },
        "version": {
          "$ref": "../quantity/1.schema.json#/$defs/workloadVersion"
        }
      },
      "required": [
        "id",
        "version",
        "file_digest",
        "model",
        "corpus_digest",
        "prompt_seed",
        "prompt_set_digest"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema",
    "run_id",
    "release",
    "control",
    "harness",
    "runner",
    "claim",
    "provider",
    "system",
    "workload",
    "profile",
    "machine",
    "self_test",
    "commands",
    "commitment",
    "proofs",
    "warnings"
  ],
  "title": "Everything needed to rerun a job: results/.../<run-id>/manifest.json (RFC-0014 §manifest.json)",
  "type": "object"
}
