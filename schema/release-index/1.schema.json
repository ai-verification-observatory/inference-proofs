{
  "$defs": {
    "card": {
      "additionalProperties": false,
      "properties": {
        "card_version": {
          "minimum": 1,
          "type": "integer"
        },
        "configuration": {
          "$ref": "../quantity/1.schema.json#/$defs/configurationId"
        },
        "digest": {
          "$ref": "../quantity/1.schema.json#/$defs/digest"
        },
        "path": {
          "pattern": "^systems/[a-z][a-z0-9-]{1,31}/(claim|claims/[a-z0-9][a-z0-9-]{0,47})\\.yaml$",
          "type": "string"
        },
        "system": {
          "$ref": "../quantity/1.schema.json#/$defs/systemId"
        }
      },
      "required": [
        "system",
        "configuration",
        "card_version",
        "path",
        "digest"
      ],
      "type": "object"
    },
    "value": {
      "oneOf": [
        {
          "$ref": "../quantity/1.schema.json#/$defs/quantity"
        },
        {
          "$ref": "../quantity/1.schema.json#/$defs/statistic"
        }
      ]
    }
  },
  "$id": "https://inference-proofs.org/schema/release-index/1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim_cards": {
      "items": {
        "$ref": "#/$defs/card"
      },
      "type": "array"
    },
    "configurations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "configuration": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "../quantity/1.schema.json#/$defs/configurationId"
              }
            ]
          },
          "effective_tier": {
            "enum": [
              "reported",
              "peer-reviewed",
              "reproduced"
            ]
          },
          "evidence": {
            "additionalProperties": false,
            "properties": {
              "reproductions": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "reviews": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "reviews",
              "reproductions"
            ],
            "type": "object"
          },
          "ineligible": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "reasons": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "run_id": {
                  "$ref": "../quantity/1.schema.json#/$defs/runId"
                }
              },
              "required": [
                "run_id",
                "reasons"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "insufficient_repetitions": {
            "type": "boolean"
          },
          "load_point": {
            "$comment": "RFC-0015 SRV-1: a production-serving configuration's load point (absent: matched)",
            "enum": [
              "matched",
              "high"
            ]
          },
          "overhead_conditions": {
            "$comment": "RFC-0004 INV-DERIVE-9: the conditions of a system configuration's overhead, each generated from the records; the site prints every conditions string from this block",
            "additionalProperties": false,
            "properties": {
              "batch": {
                "additionalProperties": false,
                "properties": {
                  "high": {
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "matched": {
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "required": [
                  "high",
                  "matched"
                ],
                "type": "object"
              },
              "batches_per_session": {
                "additionalProperties": false,
                "properties": {
                  "serving_high": {
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "serving_matched": {
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "system": {
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "required": [
                  "serving_high",
                  "serving_matched",
                  "system"
                ],
                "type": "object"
              },
              "decoding": {
                "const": "greedy"
              },
              "engine": {
                "additionalProperties": false,
                "properties": {
                  "image_digest": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "interface": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "max_num_batched_tokens": {
                    "$comment": "the batched-token limit each chosen serving configuration's engine logged at start (manifest engine.observed)",
                    "additionalProperties": false,
                    "properties": {
                      "high": {
                        "minimum": 1,
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "matched": {
                        "minimum": 1,
                        "type": [
                          "integer",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "high",
                      "matched"
                    ],
                    "type": "object"
                  },
                  "name": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "settings": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "settings_high": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "version": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "image_digest",
                  "interface",
                  "max_num_batched_tokens",
                  "name",
                  "settings",
                  "settings_high",
                  "version"
                ],
                "type": "object"
              },
              "gpu_model": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "gpus": {
                "additionalProperties": false,
                "properties": {
                  "serving": {
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "serving_high": {
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "system": {
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "required": [
                  "serving",
                  "serving_high",
                  "system"
                ],
                "type": "object"
              },
              "high_configuration": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "n": {
                "additionalProperties": false,
                "properties": {
                  "serving_high": {
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "serving_matched": {
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "system": {
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "required": [
                  "serving_high",
                  "serving_matched",
                  "system"
                ],
                "type": "object"
              },
              "profiles": {
                "additionalProperties": false,
                "properties": {
                  "serving": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "serving_high": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "system": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "serving",
                  "serving_high",
                  "system"
                ],
                "type": "object"
              },
              "prompt_count_run": {
                "additionalProperties": false,
                "properties": {
                  "serving_high": {
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "serving_matched": {
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "system": {
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "required": [
                  "serving_high",
                  "serving_matched",
                  "system"
                ],
                "type": "object"
              },
              "proved_precision": {
                "minLength": 1,
                "type": "string"
              },
              "runtime": {
                "enum": [
                  "hosted",
                  "docker host"
                ]
              },
              "serving_configuration": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "serving_model": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "digest": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "id": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "precision": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "publisher": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "release_statement": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "version": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "digest",
                      "id",
                      "precision",
                      "publisher",
                      "release_statement",
                      "version"
                    ],
                    "type": "object"
                  }
                ]
              },
              "warm": {
                "type": "boolean"
              },
              "weight_bits": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "batch",
              "batches_per_session",
              "decoding",
              "engine",
              "gpu_model",
              "gpus",
              "high_configuration",
              "n",
              "profiles",
              "prompt_count_run",
              "proved_precision",
              "runtime",
              "serving_configuration",
              "serving_model",
              "warm",
              "weight_bits"
            ],
            "type": "object"
          },
          "profile": {
            "$ref": "../quantity/1.schema.json#/$defs/profileId"
          },
          "runs": {
            "items": {
              "$ref": "../quantity/1.schema.json#/$defs/runId"
            },
            "type": "array"
          },
          "statistics": {
            "additionalProperties": {
              "$ref": "#/$defs/value"
            },
            "propertyNames": {
              "$ref": "../quantity/1.schema.json#/$defs/metricId"
            },
            "type": "object"
          },
          "steady_boundary": {
            "$comment": "RFC-0004 INV-SCOPE-5: present when a completed run of the configuration at batch size above 1 was recorded before the batch-membership rule; its steady figures keep the first-proof boundary (APP-1) and join no D-OVERHEAD-S",
            "const": "first-proof boundary (before 2026-11-09)"
          },
          "system": {
            "$ref": "../quantity/1.schema.json#/$defs/systemId"
          },
          "workload": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "../quantity/1.schema.json#/$defs/workloadId"
              },
              "version": {
                "$ref": "../quantity/1.schema.json#/$defs/workloadVersion"
              }
            },
            "required": [
              "id",
              "version"
            ],
            "type": "object"
          }
        },
        "required": [
          "system",
          "workload",
          "profile",
          "configuration",
          "runs",
          "ineligible",
          "insufficient_repetitions",
          "statistics",
          "effective_tier",
          "evidence"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "controls": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "counts": {
            "$comment": "structural counts of control records, plain integers (RFC-0012 §Labelled quantity)",
            "additionalProperties": false,
            "properties": {
              "accepted": {
                "minimum": 0,
                "type": "integer"
              },
              "error": {
                "minimum": 0,
                "type": "integer"
              },
              "invalid_call": {
                "minimum": 0,
                "type": "integer"
              },
              "no_verdict": {
                "minimum": 0,
                "type": "integer"
              },
              "not_applicable": {
                "minimum": 0,
                "type": "integer"
              },
              "prover_failed": {
                "minimum": 0,
                "type": "integer"
              },
              "rejected": {
                "minimum": 0,
                "type": "integer"
              },
              "void": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "rejected",
              "accepted",
              "no_verdict",
              "invalid_call",
              "void",
              "not_applicable",
              "error",
              "prover_failed"
            ],
            "type": "object"
          },
          "outside_expected": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "control_id": {
                  "$ref": "../quantity/1.schema.json#/$defs/controlId"
                },
                "outcome": {
                  "enum": [
                    "rejected",
                    "accepted",
                    "no_verdict",
                    "invalid_call",
                    "void",
                    "not_applicable",
                    "error",
                    "prover_failed"
                  ]
                },
                "run_id": {
                  "$ref": "../quantity/1.schema.json#/$defs/runId"
                }
              },
              "required": [
                "control_id",
                "run_id",
                "outcome"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "profile": {
            "$ref": "../quantity/1.schema.json#/$defs/profileId"
          },
          "system": {
            "$ref": "../quantity/1.schema.json#/$defs/systemId"
          },
          "workload": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "../quantity/1.schema.json#/$defs/workloadId"
              },
              "version": {
                "$ref": "../quantity/1.schema.json#/$defs/workloadVersion"
              }
            },
            "required": [
              "id",
              "version"
            ],
            "type": "object"
          }
        },
        "required": [
          "system",
          "workload",
          "profile",
          "counts",
          "outside_expected"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "freeze_derived": {
      "$comment": "RFC-0004 Q3: values the freeze evaluated for runs stored before their formula existed, by run id and metric id; D-STAT inputs point here",
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/value"
        },
        "propertyNames": {
          "$ref": "../quantity/1.schema.json#/$defs/metricId"
        },
        "type": "object"
      },
      "propertyNames": {
        "$ref": "../quantity/1.schema.json#/$defs/runId"
      },
      "type": "object"
    },
    "inputs_digest": {
      "$ref": "../quantity/1.schema.json#/$defs/digest"
    },
    "reference": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "../quantity/1.schema.json#/$defs/digest"
        },
        "file": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "file",
        "digest"
      ],
      "type": "object"
    },
    "release": {
      "$ref": "../quantity/1.schema.json#/$defs/releaseId"
    },
    "schema": {
      "const": "release-index/1"
    },
    "targets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "least_favourable": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/value"
              }
            ]
          },
          "mean": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/value"
              }
            ]
          },
          "profile": {
            "$ref": "../quantity/1.schema.json#/$defs/profileId"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {
            "enum": [
              "meets",
              "does_not_meet",
              "not_evaluable"
            ]
          },
          "system": {
            "$ref": "../quantity/1.schema.json#/$defs/systemId"
          },
          "target": {
            "pattern": "^targets/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*\\.yaml$",
            "type": "string"
          },
          "workload": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "../quantity/1.schema.json#/$defs/workloadId"
              },
              "version": {
                "$ref": "../quantity/1.schema.json#/$defs/workloadVersion"
              }
            },
            "required": [
              "id",
              "version"
            ],
            "type": "object"
          }
        },
        "required": [
          "target",
          "system",
          "workload",
          "profile",
          "result",
          "reason",
          "mean",
          "least_favourable"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "release",
    "configurations",
    "controls",
    "targets",
    "claim_cards",
    "reference",
    "inputs_digest"
  ],
  "title": "Frozen release index: releases/<release>/index.json (RFC-0009 §Release record, §Freeze algorithm)",
  "type": "object"
}
