{
  "$defs": {
    "cause": {
      "$comment": "RFC-0018 §The six checks: the causes of an undecided check",
      "enum": [
        "system limit",
        "not run",
        "not resolved",
        "not reproduced"
      ]
    },
    "control": {
      "additionalProperties": false,
      "allOf": [
        {
          "$comment": "a control that ran has scores and a mean; one that failed has its cause and neither (RFC-0018 failure modes)",
          "else": {
            "properties": {
              "cause": {
                "minLength": 1,
                "type": "string"
              },
              "mean_prefix": {
                "type": "null"
              },
              "scores": {
                "maxItems": 0
              }
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "properties": {
              "cause": {
                "type": "null"
              },
              "mean_prefix": {
                "type": "number"
              },
              "scores": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "properties": {
        "cause": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "honest",
            "damaged"
          ]
        },
        "kl": {
          "$comment": "FI-7: mean KL divergence per token against the reference, measured by llama.cpp; never gating",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "../quantity/1.schema.json#/$defs/quantity"
            }
          ]
        },
        "mean_prefix": {
          "type": [
            "number",
            "null"
          ]
        },
        "recipe": {
          "enum": [
            "rerun",
            "quantize",
            "drop_blocks",
            "other_model"
          ]
        },
        "scores": {
          "$ref": "#/$defs/scores"
        },
        "status": {
          "enum": [
            "ok",
            "failed"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "recipe",
        "status",
        "cause",
        "scores",
        "mean_prefix",
        "kl"
      ],
      "type": "object"
    },
    "p": {
      "exclusiveMinimum": 0,
      "maximum": 1,
      "type": "number"
    },
    "row": {
      "additionalProperties": false,
      "allOf": [
        {
          "$comment": "FI-6: held and failed carry no cause; undecided names one",
          "else": {
            "properties": {
              "cause": {
                "$ref": "#/$defs/cause"
              }
            }
          },
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "held",
                  "failed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "cause": {
                "type": "null"
              },
              "p_above_bar": {
                "$ref": "#/$defs/p"
              },
              "p_below_bar": {
                "$ref": "#/$defs/p"
              }
            }
          }
        }
      ],
      "properties": {
        "cause": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/cause"
            }
          ]
        },
        "kl": {
          "$comment": "FI-7: on the file the system commits when llama.cpp loads it, else null with kl_note saying why",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "../quantity/1.schema.json#/$defs/quantity"
            }
          ]
        },
        "kl_note": {
          "type": "string"
        },
        "mean_prefix": {
          "type": [
            "number",
            "null"
          ]
        },
        "p_above_bar": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/p"
            }
          ]
        },
        "p_below_bar": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/p"
            }
          ]
        },
        "scores": {
          "$ref": "#/$defs/scores"
        },
        "state": {
          "enum": [
            "held",
            "failed",
            "undecided"
          ]
        },
        "step_tests": {
          "$comment": "the row's tests over the two thresholds; an entry is null when its threshold's value is null, the key null when the row has no scores",
          "additionalProperties": false,
          "properties": {
            "green": {
              "else": {
                "type": "null"
              },
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/step_test"
              }
            },
            "upper": {
              "else": {
                "type": "null"
              },
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/step_test"
              }
            }
          },
          "required": [
            "green",
            "upper"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "tests": {
          "$comment": "the two tests of FI-6: the row over the bar, then the bar over the row",
          "items": {
            "$ref": "#/$defs/test"
          },
          "maxItems": 2,
          "type": "array"
        }
      },
      "required": [
        "scores",
        "mean_prefix",
        "p_above_bar",
        "p_below_bar",
        "state",
        "cause",
        "kl",
        "kl_note",
        "tests"
      ],
      "type": "object"
    },
    "scores": {
      "$comment": "FI-3: matched prefix per prompt, in prompt order",
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "type": "array"
    },
    "step_test": {
      "$comment": "FM-5, FM-6: the FI-4 one-sided sign-flip test of the row's per-prompt scores over the constant threshold `value`, run on d_i = 2n*s_i - (S_a + S_b)",
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "exact",
            "monte-carlo"
          ]
        },
        "n": {
          "minimum": 1,
          "type": "integer"
        },
        "p": {
          "$ref": "#/$defs/p"
        },
        "seed": {
          "pattern": "^0x[0-9a-f]{16}$",
          "type": [
            "string",
            "null"
          ]
        },
        "threshold": {
          "enum": [
            "T_green",
            "T_upper"
          ]
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "threshold",
        "value",
        "n",
        "p",
        "method",
        "seed"
      ],
      "type": "object"
    },
    "test": {
      "$comment": "FI-4: one paired one-sided sign-flip test of a over b",
      "additionalProperties": false,
      "properties": {
        "a": {
          "minLength": 1,
          "type": "string"
        },
        "b": {
          "minLength": 1,
          "type": "string"
        },
        "method": {
          "enum": [
            "exact",
            "monte-carlo"
          ]
        },
        "n": {
          "minimum": 1,
          "type": "integer"
        },
        "p": {
          "$ref": "#/$defs/p"
        },
        "seed": {
          "pattern": "^0x[0-9a-f]{16}$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "a",
        "b",
        "n",
        "p",
        "method",
        "seed"
      ],
      "type": "object"
    },
    "threshold": {
      "$comment": "one step threshold: (S_a + S_b) / (2n) over the two named controls' scores; null with a cause when a control is missing, failed or has another score count",
      "additionalProperties": false,
      "properties": {
        "cause": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "controls": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 0,
          "type": "array"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "controls",
        "value",
        "cause"
      ],
      "type": "object"
    }
  },
  "$id": "https://inference-proofs.org/schema/fidelity/1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bar": {
      "$comment": "FI-5: the damaged control with the highest mean that every honest control beats; null when none qualifies",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "control": {
              "minLength": 1,
              "type": "string"
            },
            "mean_prefix": {
              "type": "number"
            }
          },
          "required": [
            "control",
            "mean_prefix"
          ],
          "type": "object"
        }
      ]
    },
    "bar_tests": {
      "$comment": "FI-5: every honest control against every damaged control that ran",
      "items": {
        "$ref": "#/$defs/test"
      },
      "type": "array"
    },
    "controls": {
      "$comment": "FI-2, in the level file's order",
      "items": {
        "$ref": "#/$defs/control"
      },
      "type": "array"
    },
    "engine": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "$ref": "../quantity/1.schema.json#/$defs/commit"
        },
        "image": {
          "$comment": "the ref-fidelity image the replies were generated in",
          "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "repo": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "type": "string"
        },
        "tool": {
          "$comment": "RFC-0018 FI-9: vllm where the level's llama.cpp pin cannot run the 16-bit reference",
          "enum": ["llama.cpp", "vllm"]
        }
      },
      "required": [
        "tool",
        "repo",
        "commit",
        "image"
      ],
      "type": "object"
    },
    "level": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "../quantity/1.schema.json#/$defs/digest"
        },
        "id": {
          "pattern": "^L[1-9][0-9]*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "digest"
      ],
      "type": "object"
    },
    "n": {
      "$comment": "the rung's 3 N prompts",
      "minimum": 1,
      "type": "integer"
    },
    "prompts_digest": {
      "$comment": "sha256 of the prompts.jsonl the replies answer (3 N prompts, prompt order)",
      "$ref": "../quantity/1.schema.json#/$defs/digest"
    },
    "reference": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "../quantity/1.schema.json#/$defs/digest"
        },
        "replies": {
          "$comment": "FI-1: results/<release>/fidelity/<rung>/reference.jsonl",
          "pattern": "^results/v[0-9]+\\.[0-9]+/fidelity/[^/]+/reference\\.jsonl$",
          "type": "string"
        }
      },
      "required": [
        "replies",
        "digest"
      ],
      "type": "object"
    },
    "rows": {
      "additionalProperties": {
        "$ref": "#/$defs/row"
      },
      "propertyNames": {
        "$ref": "../quantity/1.schema.json#/$defs/systemId"
      },
      "type": "object"
    },
    "rung": {
      "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$",
      "type": "string"
    },
    "schema": {
      "const": "fidelity/1"
    },
    "slots": {
      "$comment": "FI-1: the fidelity run's slot count, copied from fidelity-run.json; green needs 1 (FM-5)",
      "minimum": 1,
      "type": "integer"
    },
    "steps": {
      "$comment": "Faithful model's step thresholds from the rung's honest controls: green from the rerun and Q8_0, upper from Q8_0 and Q4_K_M",
      "additionalProperties": false,
      "properties": {
        "green": {
          "$ref": "#/$defs/threshold"
        },
        "rule": {
          "minLength": 1,
          "type": "string"
        },
        "seed_rule": {
          "minLength": 1,
          "type": "string"
        },
        "upper": {
          "$ref": "#/$defs/threshold"
        }
      },
      "required": [
        "rule",
        "seed_rule",
        "green",
        "upper"
      ],
      "type": "object"
    },
    "test": {
      "additionalProperties": false,
      "properties": {
        "alpha": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "exact_up_to": {
          "minimum": 0,
          "type": "integer"
        },
        "resamples": {
          "minimum": 1,
          "type": "integer"
        },
        "score": {
          "const": "matched_prefix"
        },
        "seed_rule": {
          "minLength": 1,
          "type": "string"
        },
        "test": {
          "const": "paired-sign-flip"
        }
      },
      "required": [
        "score",
        "test",
        "alpha",
        "exact_up_to",
        "resamples",
        "seed_rule"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema",
    "level",
    "rung",
    "n",
    "prompts_digest",
    "engine",
    "reference",
    "test",
    "controls",
    "bar_tests",
    "bar",
    "rows"
  ],
  "title": "The fidelity gate of one rung: controls, bar and rows (RFC-0018 FI-1 to FI-8)",
  "type": "object"
}
