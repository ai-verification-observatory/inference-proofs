{
  "$id": "https://inference-proofs.org/schema/adapter-job/1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "subcommand": {
            "const": "info"
          }
        }
      },
      "then": {
        "properties": {
          "batch_size": false,
          "batches": false,
          "change": false,
          "claimed_output": false,
          "claims_file": false,
          "commitment_id": false,
          "control_flags": false,
          "model_dir": false,
          "out_dir": false,
          "position": false,
          "prompts_file": false,
          "proof_dir": false,
          "prover_files": false,
          "request": false,
          "texts_file": false,
          "token": false,
          "verifier_files": false
        },
        "required": []
      }
    },
    {
      "if": {
        "properties": {
          "subcommand": {
            "const": "setup"
          }
        }
      },
      "then": {
        "properties": {
          "batch_size": false,
          "batches": false,
          "change": false,
          "claimed_output": false,
          "claims_file": false,
          "commitment_id": false,
          "control_flags": false,
          "model_dir": false,
          "out_dir": false,
          "position": false,
          "prompts_file": false,
          "proof_dir": false,
          "prover_files": false,
          "request": false,
          "texts_file": false,
          "token": false,
          "verifier_files": false
        },
        "required": []
      }
    },
    {
      "if": {
        "properties": {
          "subcommand": {
            "const": "commit"
          }
        }
      },
      "then": {
        "properties": {
          "batch_size": false,
          "batches": false,
          "change": false,
          "claimed_output": false,
          "claims_file": false,
          "commitment_id": false,
          "control_flags": false,
          "out_dir": false,
          "position": false,
          "prompts_file": false,
          "proof_dir": false,
          "prover_files": false,
          "request": false,
          "texts_file": false,
          "token": false,
          "verifier_files": false
        },
        "required": [
          "model_dir"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "subcommand": {
            "const": "prove"
          }
        }
      },
      "then": {
        "properties": {
          "change": false,
          "claimed_output": false,
          "out_dir": false,
          "position": false,
          "proof_dir": false,
          "request": false,
          "texts_file": false,
          "token": false,
          "verifier_files": false
        },
        "required": [
          "commitment_id",
          "prover_files",
          "model_dir",
          "prompts_file",
          "batch_size",
          "batches"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "subcommand": {
            "const": "verify"
          }
        }
      },
      "then": {
        "properties": {
          "batch_size": false,
          "batches": false,
          "change": false,
          "claims_file": false,
          "control_flags": false,
          "model_dir": false,
          "out_dir": false,
          "position": false,
          "prompts_file": false,
          "prover_files": false,
          "texts_file": false,
          "token": false
        },
        "required": [
          "commitment_id",
          "verifier_files",
          "request",
          "claimed_output",
          "proof_dir"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "subcommand": {
            "const": "logprobs"
          }
        }
      },
      "then": {
        "properties": {
          "batch_size": false,
          "batches": false,
          "change": false,
          "claimed_output": false,
          "claims_file": false,
          "control_flags": false,
          "out_dir": false,
          "position": false,
          "prompts_file": false,
          "proof_dir": false,
          "request": false,
          "token": false,
          "verifier_files": false
        },
        "required": [
          "commitment_id",
          "prover_files",
          "model_dir",
          "texts_file"
        ]
      }
    },
    {
      "$comment": "RFC-0018 CO-4: a ladder prove job names its ladder and batch counts, and only a ladder job does",
      "else": {
        "properties": {
          "ladder": false,
          "timed_batches": false,
          "warmup_batches": false
        }
      },
      "if": {
        "properties": {
          "load_point": {
            "const": "ladder"
          }
        },
        "required": [
          "load_point"
        ]
      },
      "then": {
        "required": [
          "ladder",
          "warmup_batches",
          "timed_batches"
        ]
      }
    },
    {
      "$comment": "weakening flags only in control jobs (RFC-0005 rule 4, AGENTS.md rule 4)",
      "if": {
        "required": [
          "control_flags"
        ]
      },
      "then": {
        "properties": {
          "control": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subcommand": {
            "const": "perturb"
          }
        }
      },
      "then": {
        "properties": {
          "batch_size": false,
          "batches": false,
          "claimed_output": false,
          "claims_file": false,
          "commitment_id": false,
          "control_flags": false,
          "gpus": false,
          "ladder": false,
          "load_point": false,
          "position": false,
          "prompts_file": false,
          "proof_dir": false,
          "prover_files": false,
          "request": false,
          "texts_file": false,
          "timed_batches": false,
          "token": false,
          "verifier_files": false,
          "warmup_batches": false
        },
        "required": [
          "change",
          "model_dir",
          "out_dir"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "subcommand": {
            "const": "mutate_reply"
          }
        }
      },
      "then": {
        "properties": {
          "batch_size": false,
          "batches": false,
          "change": false,
          "claimed_output": false,
          "claims_file": false,
          "commitment_id": false,
          "control_flags": false,
          "gpus": false,
          "ladder": false,
          "load_point": false,
          "model_dir": false,
          "prompts_file": false,
          "prover_files": false,
          "request": false,
          "texts_file": false,
          "timed_batches": false,
          "verifier_files": false,
          "warmup_batches": false
        },
        "required": [
          "proof_dir",
          "position",
          "token",
          "out_dir"
        ]
      }
    }
  ],
  "properties": {
    "batch_size": {
      "minimum": 1,
      "type": "integer"
    },
    "batches": {
      "minimum": 1,
      "type": "integer"
    },
    "change": {
      "$comment": "perturb (RFC-0018 AD-5): the level's model_change for this system",
      "minLength": 1,
      "type": "string"
    },
    "claimed_output": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "type": "array"
    },
    "claims_file": {
      "$comment": "prove of a ref-recompute job: one JSON array of claimed token ids per request, in request order (RFC-0015 RC-1)",
      "minLength": 1,
      "type": "string"
    },
    "commitment_id": {
      "minLength": 1,
      "type": "string"
    },
    "contract": {
      "const": "adapter/1"
    },
    "control": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$comment": "RFC-0018: a level's MODEL control job (C3 commit, P1 prove) with W' mounted at /models",
          "additionalProperties": false,
          "properties": {
            "id": {
              "enum": [
                "P1",
                "C3"
              ]
            },
            "perturbation": {
              "$comment": "RFC-0018 AD-5: the record the adapter's perturb returns",
              "additionalProperties": false,
              "properties": {
                "digest_tool": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "digest_w": {
                  "minLength": 1,
                  "type": "string"
                },
                "digest_w_prime": {
                  "minLength": 1,
                  "type": "string"
                },
                "index": {
                  "minimum": 0,
                  "type": "integer"
                },
                "new": {},
                "old": {},
                "tensor": {
                  "minLength": 1,
                  "type": "string"
                },
                "unit": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "tensor",
                "index",
                "old",
                "new",
                "unit",
                "digest_w",
                "digest_w_prime",
                "digest_tool"
              ],
              "type": "object"
            }
          },
          "required": [
            "id",
            "perturbation"
          ],
          "type": "object"
        }
      ]
    },
    "control_flags": {
      "items": {
        "pattern": "^-",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "gpus": {
      "$comment": "RFC-0015 SRV-6: the GPUs a production-serving prove job binds (its --tensor-parallel-size)",
      "minimum": 1,
      "type": "integer"
    },
    "ladder": {
      "$comment": "RFC-0018 CO-4: a ladder prove job's concurrencies, the level's baseline.ladder in its order",
      "items": {
        "minimum": 1,
        "type": "integer"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "load_point": {
      "$comment": "RFC-0015 SRV-1: a production-serving prove job's load point; RFC-0018 CO-4: `ladder`",
      "enum": [
        "matched",
        "high",
        "ladder"
      ]
    },
    "model_dir": {
      "const": "/models"
    },
    "out_dir": {
      "$comment": "perturb and mutate_reply: where the adapter writes W' or the mutated proof",
      "pattern": "^/io/[^\\x00]+$",
      "type": "string"
    },
    "position": {
      "$comment": "mutate_reply (RFC-0018 AD-6): 0-based reply position",
      "minimum": 0,
      "type": "integer"
    },
    "prompts_file": {
      "pattern": "^/io/[^\\x00]+$",
      "type": "string"
    },
    "proof_dir": {
      "pattern": "^/io/[^\\x00]+$",
      "type": "string"
    },
    "prover_files": {
      "items": {
        "pattern": "^/io/state/[^\\x00]+$",
        "type": "string"
      },
      "type": "array"
    },
    "request": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "type": "array"
    },
    "run_id": {
      "$ref": "../quantity/1.schema.json#/$defs/runId"
    },
    "schema": {
      "const": "adapter-job/1"
    },
    "shape": {
      "additionalProperties": false,
      "properties": {
        "batch_size": {
          "minimum": 1,
          "type": "integer"
        },
        "batches_per_session": {
          "minimum": 1,
          "type": "integer"
        },
        "context_window": {
          "minimum": 1,
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 1,
          "type": "integer"
        },
        "prompt_tokens": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "prompt_tokens",
        "output_tokens",
        "batch_size",
        "batches_per_session",
        "context_window"
      ],
      "type": "object"
    },
    "subcommand": {
      "enum": [
        "info",
        "setup",
        "commit",
        "prove",
        "verify",
        "logprobs",
        "perturb",
        "mutate_reply"
      ]
    },
    "texts_file": {
      "$comment": "logprobs (RFC-0018 AD-2): one JSON array of token ids per text",
      "pattern": "^/io/[^\\x00]+$",
      "type": "string"
    },
    "timed_batches": {
      "$comment": "RFC-0018 CO-4: timed batches per concurrency of a ladder prove job (baseline.timed_batches)",
      "minimum": 1,
      "type": "integer"
    },
    "token": {
      "$comment": "mutate_reply: the new token id",
      "minimum": 0,
      "type": "integer"
    },
    "verifier_files": {
      "items": {
        "pattern": "^/io/[^\\x00]+$",
        "type": "string"
      },
      "type": "array"
    },
    "warmup_batches": {
      "$comment": "RFC-0018 CO-4: warm-up batches per concurrency of a ladder prove job (baseline.warmup_batches)",
      "minimum": 1,
      "type": "integer"
    },
    "workload": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "../quantity/1.schema.json#/$defs/workloadId"
        },
        "version": {
          "$ref": "../quantity/1.schema.json#/$defs/workloadVersion"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema",
    "contract",
    "subcommand",
    "run_id",
    "workload",
    "shape",
    "control"
  ],
  "title": "Adapter job file /io/job.json written by the harness (RFC-0005 §Subcommands and file shapes)",
  "type": "object"
}
