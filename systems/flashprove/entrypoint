CALIBRATION = Path(os.environ.get("IPROOFS_FLASHPROVE_CALIBRATION", "/opt/iproofs/calibration"))
CONFIG_FILES = ("policy.txt", "KL.bin", "layout.txt")
# Each gives up weight hiding (U/docs/operators-duties.md "Public weights", "What the secret key
