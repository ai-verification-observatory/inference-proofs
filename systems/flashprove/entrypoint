            4: "invalid_call", 14: "invalid_call", 15: "invalid_call"}  # fmt: skip


def host(container_path: str) -> Path:
    for prefix, env in (("/io", "IPROOFS_IO"), ("/models", "IPROOFS_MODELS")):
        if container_path == prefix or container_path.startswith(prefix + "/"):
            return Path(os.environ.get(env, prefix) + container_path[len(prefix) :])
    raise SystemExit(f"flashprove: path {container_path!r} outside /io and /models")


def base(sub: str) -> dict[str, object]:
    return {"schema": "adapter-out/1", "contract": "adapter/1", "subcommand": sub,
            "phases": [], "warnings": []}  # fmt: skip


def private(path: Path) -> Path:
    """A new directory closed to group and others, as cp_prove asks of -isk, -spool, HOME and
    TMPDIR (U/docs/service.md "What cp_prove does at startup", step 1)."""
    path.parent.mkdir(parents=True, exist_ok=True)
    path.mkdir(mode=0o700)
    return path


def workdir(path: Path) -> Path:
    """A step's work directory, with the HOME and TMPDIR that `run` gives the programs below it
    (U/docs/operators-duties.md step 15; U/driver/measure_rate.py line 685)."""
    for p in (path, path / "home", path / "tmp"):
        private(p)
    return path


def run(argv: list[str], job: dict, cwd: Path, out: Path, err: Path | None = None,
        poll: Callable[[], None] | None = None, at: Path | None = None,
        env: dict[str, str] | None = None) -> int:  # fmt: skip
    """Starts one upstream process, after the RFC-0005 rule 4 check, and logs it. HOME and TMPDIR
    are below `cwd`; the process runs in `at` when given, else in `cwd`."""
    weakening = [a for a in argv if any(a.startswith(f) for f in FORBIDDEN_FLAGS)]
    if weakening and not job.get("control"):
        raise SystemExit(f"flashprove: refusing {weakening} outside a control job")
    env = dict(os.environ, **(env or {}), HOME=str(cwd / "home"), TMPDIR=str(cwd / "tmp"))
    started = time.monotonic_ns()
    with out.open("wb") as o, open(err or os.devnull, "wb") as e:
        proc = subprocess.Popen(argv, cwd=at or cwd, env=env, stdout=o,
                                stderr=e if err else subprocess.STDOUT)  # fmt: skip
        while proc.poll() is None:
            if poll is None:
                proc.wait()
            else:
                poll()
                time.sleep(POLL_S)
    if poll is not None:
        poll()
    line = {
        "argv": argv,
        "cwd": str(at or cwd),
        "started_mono_ns": started,
        "exit_code": proc.returncode,
    }
    with host("/io/commands.jsonl").open("a") as f:
        f.write(json.dumps(line, sort_keys=True) + "\n")
    return proc.returncode


def last_line(path: Path) -> str:
    lines = [ln for ln in path.read_text(errors="replace").splitlines() if ln.strip()]
    return lines[-1].encode()[:4096].decode(errors="ignore") if lines else ""


def pack(words: list[int]) -> bytes:
    return b"".join(w.to_bytes(4, "little") for w in words)


def info(job: dict) -> dict:
    out = {**base("info"), "system": "flashprove", "upstream_commit": UPSTREAM_COMMIT,
           "image_inputs": json.loads(INPUTS.read_text())["inputs"] if INPUTS.is_file() else [],
           "workloads": WORKLOADS, "profile": "prover-h100",
           "contract_versions": ["adapter/1"], "optional_subcommands": OPTIONAL}  # fmt: skip
    if "IPROOFS_ADAPTER_COMMIT" in os.environ:  # baked in by the image build (B6)
        out["adapter_commit"] = os.environ["IPROOFS_ADAPTER_COMMIT"]
        out["adapter_dirty"] = os.environ.get("IPROOFS_ADAPTER_DIRTY", "true") != "false"
    return out


def clone(src: Path, dst: Path) -> None:
    """A copy of src that shares its blocks where the file system can (FICLONE), else a copy."""
    with src.open("rb") as i, dst.open("wb") as o:
        try:
            fcntl.ioctl(o.fileno(), 0x40049409, i.fileno())  # FICLONE, linux/fs.h
        except OSError:
            shutil.copyfileobj(i, o, 64 << 20)


def cpu_count() -> int:
    """The CPUs this process may use (its affinity), as upstream's programs size their threads."""
    if hasattr(os, "sched_getaffinity"):
        return len(os.sched_getaffinity(0))
    return os.cpu_count() or 1


def expected() -> dict[str, str]:
    """U/examples/maverick/expected.txt: the published digests, by the name run.sh compares."""
    text = (SRC / "examples/maverick/expected.txt").read_text()
    return dict(ln.split()[::-1] for ln in text.splitlines() if ln.strip())


def control_id(job: dict) -> str | None:
    """The id of a Level 1 control job (`control: {"id": ..., "perturbation": ...}`), else None."""
    control = job.get("control")
    return str(control.get("id")) if isinstance(control, dict) else None


def published(path: Path, name: str, job: dict) -> None:
    """The file must have upstream's published digest; in a P1 or C3 control job, whose model
    is W' (RFC-0018 CH-2), another digest is accepted and recorded in the warnings."""
    if not path.is_file():
        raise SystemExit(f"flashprove: {path} is missing")
    if hashlib.sha256(path.read_bytes()).hexdigest() == expected()[name]:
        return
    if control_id(job) not in W_PRIME_CONTROLS:
        raise SystemExit(f"flashprove: {path} is not the published {name}")
    WARNINGS.append(f"{name} is not the published one: accepted in control job "
                    f"{control_id(job)}, whose model is W' (RFC-0018 CH-2)")  # fmt: skip


def mark(name: str) -> None:
    """RFC-0018 AD-4: an empty /io/marks/<name>, written under a temporary name and renamed, so
    the harness times it as it times a proof release."""
    marks = host("/io/marks")
    marks.mkdir(parents=True, exist_ok=True)
    (marks / f".tmp-{name}").write_bytes(b"")
    os.rename(marks / f".tmp-{name}", marks / name)


def setup(job: dict) -> dict:
    """The stage fit of U/examples/maverick/run.sh (L1451-1513) into /io/fit: the calibration set
    (U/scales/README.md "The calibration set"), wsums.txt by bin/weight_sums, fold.txt and
    layout.txt, the scales by scales/calibrate.py on the GPU and policy.txt and KL.bin by
    scales/words_to_policy.py; wsums.txt and KL.bin must have the published digests. cp_commit
    and cp_prove read the weights with wsums.txt and fold.txt beside them, and /models is read
    only, so the weight files are copied (cloned where the file system can) into /io/fit/weights."""
    fit, model = workdir(host(FIT)), host(MODEL)
    weights, config = private(host(WEIGHTS)), private(host(FIT_CONFIG))
    private(fit / "model")
    names = SHARDS
    cal = [str(CALIBRATION / n) for n in ("wikitext-2-raw-v1-train.parquet",
                                          "llama2-tokenizer.json", "llama4-tokenizer.json")]
    calibration_set = fit / "calibration_set.npy"
    steps = [
        [PYTHON, "-Bs", str(SRC / "scales/make_calibration_set.py"), *cal, str(calibration_set)],
        [str(SRC / "bin/weight_sums"), "--eres", "10", "--threads",
         str(min(64, cpu_count())), "--out", str(fit / "model/wsums.txt"),
         *(str(model / n) for n in names)],
    ]  # fmt: skip
    for argv in steps:
        log = fit / f"{Path(argv[2] if argv[0] == PYTHON else argv[0]).stem}.log"
        if run(argv, job, fit, log, at=SRC) != 0:
            raise SystemExit(f"flashprove: {argv[0]} exited non-zero, last line {last_line(log)!r}")
    published(fit / "model/wsums.txt", "model/wsums.txt", job)
    (fit / "model/fold.txt").write_text("eres 10\nqkrows asis\n")
    shutil.copyfile(SRC / "prover/examples/target_full_f2/layout.txt", config / "layout.txt")
    for name in names:  # cp_commit refuses a link, and a second hard link, to a weight file
        clone(model / name, weights / name)
    for name in ("wsums.txt", "fold.txt"):
        shutil.copyfile(fit / "model" / name, weights / name)
    later = [
        [PYTHON, "-Bs", str(SRC / "scales/calibrate.py"), "--gguf", str(weights), "--wsums",
         str(weights / "wsums.txt"), "--tokens", str(calibration_set), "--out",
         str(fit / "calibration"), "--device", "cuda", "--eres", "10"],
        [PYTHON, "-Bs", str(SRC / "scales/words_to_policy.py"),
         str(SRC / "prover/examples/target_full_f2/policy.txt"), str(fit / "calibration/words.json"),
         str(weights / "wsums.txt"), str(config / "policy.txt"), str(config / "KL.bin")],
    ]  # fmt: skip
    for argv in later:
        log = fit / f"{Path(argv[2]).stem}.log"
        if run(argv, job, fit, log, at=SRC) != 0:
            raise SystemExit(f"flashprove: {argv[2]} exited non-zero, last line {last_line(log)!r}")
    published(config / "KL.bin", "config/KL.bin", job)
    return {**base("setup"), "ready": True,
            "log_files": [f"{FIT}/{p.name}" for p in sorted(fit.glob("*.log"))]}  # fmt: skip


def commit(job: dict) -> dict:
    weights, fit = host(WEIGHTS), host(FIT_CONFIG)
    # The fit must be upstream's published one: run.sh's stages fit and compare check these two
    # digests against examples/maverick/expected.txt before and after cp_commit.
    published(weights / "wsums.txt", "model/wsums.txt", job)
    published(fit / "KL.bin", "config/KL.bin", job)
    state = host("/io/state")
    work = workdir(state / "commit")
    config = private(work / "config")
    for name in CONFIG_FILES:
        shutil.copyfile(fit / name, config / name)
    argv = [str(BIN / "cp_commit"), "-weights", str(weights), "-config", str(config), "-M", "1",
            "-ivk", str(work / "ivk"), "-isk", str(work / "isk")]  # fmt: skip
    log = work / "cp_commit.log"
    code, last = run(argv, job, work, log), last_line(log)
    ids = re.findall(r"^commitment ID: ([0-9a-f]{64})$", log.read_text(errors="replace"), re.M)
    done = last.startswith("cp_commit: done.") and "is complete and can be handed out" in last
    if code != 0 or not done or len(ids) != 1:
        raise SystemExit(f"flashprove: cp_commit exited {code}, last line {last!r}")
    with tarfile.open(state / "isk.tar", "w") as tar:  # its files share names (count.bin)
        tar.add(work / "isk", arcname="isk")
    shutil.rmtree(work / "isk")  # prove uses the harness's recorded copy only
    verifier = [config / n for n in CONFIG_FILES] + [work / "ivk/key.bin"]
    verifier += sorted((work / "ivk/leaf").glob("*.bin"))
    return {**base("commit"), "commitment_id": ids[0],
            "verifier_files": [f"/io/state/{p.relative_to(state).as_posix()}" for p in verifier],
            "prover_files": ["/io/state/isk.tar"],
            "sizes": {"verifier_bytes": sum(p.stat().st_size for p in verifier),
                      "prover_bytes": (state / "isk.tar").stat().st_size}}  # fmt: skip


def window_of(policy: Path) -> int:
    """T = 2^lt, from the line `lt` of the parameter file (U/docs/verifying.md lines 115-117;
    U/integrations/vllm/integer_model/README.md line 153; target_full_f2 has `lt 10`)."""
    lts = re.findall(r"^lt (\d+)$", policy.read_text(errors="replace"), re.M)
    if len(lts) != 1:
        raise SystemExit(f"flashprove: {policy} has {len(lts)} lines `lt`, not 1")
    return 1 << int(lts[0])


def request_words(prompt: list[int], reply: list[int], t: int) -> list[int]:
    """A request for a whole reply (U/docs/verifying.md lines 115-128; the words of
    U/verifier/docs/output.md lines 364-368): the window of T tokens, prompt, reply, then filler 0
    up to T (both sides pad with 0), then r = P - 1 and e = P + R - 1, so every reply token is
    checked (RFC-0018 AD-1). A reply that ends one past the window (e = T) is not written here."""
    p, r = len(prompt), len(reply)
    if p < 1 or r < 1 or p + r > t:
        raise SystemExit(f"flashprove: {p} prompt and {r} reply tokens do not fit a window of {t}")
    return [*prompt, *reply, *[0] * (t - p - r), p - 1, p + r - 1]


def integer_model_folder(job: dict, work: Path, phases: list[dict]) -> tuple[Path, str]:
    """The folder `integer_model.load_from_folder` reads and its `sha256` options, after the
    package's float64 check on the GPU: the fit's policy.txt and KL.bin, the weights with
    wsums.txt and fold.txt beside them, every tensor checked against wsums.txt ("verify_sums")
    and the five small files against their digests, KL.bin's and wsums.txt's being the published
    ones (OPERATING.md "The files of a model", "Verify what was loaded"; integer_model/model.py
    load_from_folder)."""
    started = time.monotonic()
    log = work / "float64.log"
    argv = [IM_PYTHON, "-B", "-m", "pytest", "-p", "no:cacheprovider", "-rs",
            "tests/test_arithmetic_edges.py"]  # fmt: skip
    code = run(argv, job, work, log, at=SRC / IM_SRC, env={"INTEGER_MODEL_TEST_DEVICE": "cuda"})
    summary = last_line(log)
    if code != 0 or "passed" not in summary or NOT_ALL_PASSED.search(summary):
        raise SystemExit(f"flashprove: the float64 check exited {code}, last line {summary!r}: "
                         "not every test passed: this GPU does not serve the integer model")
    phases.append({"name": "float64_check", "seconds": time.monotonic() - started})
    weights, config = host(WEIGHTS), host(FIT_CONFIG)
    model = private(work / "integer-model")
    for name in ("policy.txt", "KL.bin"):
        shutil.copyfile(config / name, model / name)
    spec = {"weights": "blocks", "weight_settings": {
        "blocks": "gguf", "setup_folder": str(weights),
        "shards": [str(weights / n) for n in SHARDS], "verify_sums": True}}  # fmt: skip
    if control_id(job) == "P1":  # W' is proved against W's commitment and W's wsums.txt
        spec["weight_settings"]["verify_sums"] = False  # type: ignore[index]
        WARNINGS.append("integer model: verify_sums off in control job P1, whose weights are W'")
    (model / "integer_model.json").write_text(json.dumps(spec, indent=2) + "\n")
    published = expected()
    sha = {n: hashlib.sha256((model / n).read_bytes()).hexdigest()
           for n in ("integer_model.json", "policy.txt")}  # fmt: skip
    sha |= {
        "KL.bin": published["config/KL.bin"],
        "wsums.txt": published["model/wsums.txt"],
        "fold.txt": hashlib.sha256((weights / "fold.txt").read_bytes()).hexdigest(),
    }
    return model, json.dumps({"sha256": sha}, sort_keys=True)


def generate(job: dict, prompts: list[list[int]], length: int, work: Path,
             phases: list[dict]) -> list[list[int]]:  # fmt: skip
    """RFC-0018 AD-3: each reply is the committed integer model's own greedy reply, from the
    package upstream ships for it, on the files the commitment was made from
    (`integer_model_folder`)."""
    t = window_of(host(FIT_CONFIG) / "policy.txt")
    for prompt in prompts:
        request_words(prompt, [0] * length, t)  # refuses a request that does not fit
    mark("generation.start")  # RFC-0018 AD-4, CO-3: the GPU's time for the replies starts here
    model, options = integer_model_folder(job, work, phases)
    started = time.monotonic()
    listed = work / "prompts.jsonl"
    listed.write_text("".join(json.dumps(p) + "\n" for p in prompts))
    replies = work / "replies.jsonl"
    log = work / "generate.log"
    argv = [IM_PYTHON, "-B", "-c", GENERATE_PY, str(model), str(listed), str(len(prompts)),
            str(length), str(replies), options]  # fmt: skip
    if run(argv, job, work, log) != 0:
        raise SystemExit(f"flashprove: the integer model exited non-zero, last line "
                         f"{last_line(log)!r}")  # fmt: skip
    rows = [json.loads(ln) for ln in replies.read_text().splitlines()]
    if [r["prompt_token_ids"] for r in rows] != prompts or any(
        len(r["reply_token_ids"]) != length for r in rows
    ):
        raise SystemExit(f"flashprove: {replies} is not one reply of {length} per prompt")
    phases.append({"name": "generate", "seconds": time.monotonic() - started})
    mark("generation.end")
    return [[int(x) for x in r["reply_token_ids"]] for r in rows]


def logit_scale(policy: Path) -> int:
    """s, from the line `s` of the parameter file: "a logit of the model is an integer logit
    divided by 2^s. It is the provider's statement: no equation ties it to the model"
    (U/verifier/docs/parameter-file.md line 219; target_full_f2 has `s 15`)."""
    found = re.findall(r"^s (\d+)$", policy.read_text(errors="replace"), re.M)
    if len(found) != 1:
        raise SystemExit(f"flashprove: {policy} has {len(found)} lines `s`, not 1")
    return int(found[0])


def score(job: dict) -> dict:
    """RFC-0018 AD-7: the integer model's greedy choice at every position of a reply it is
    given, by the package `generate` uses, on the same folder and after the same float64 check.
    The call is the one of U/integrations/vllm/integer_model/examples/score_reply.py ("scores a
    reply that another engine served, in one forward pass", examples/README.md line 31):
    `extend(sequence, tokens[:-1], gap_for=tokens[1:])`, whose first result is the greedy choice
    after each fed token (model.py `extend`, docstring). With top_k > 0 the logits come from
    `record`, which the same docstring describes ("after the layers x_last, aF, lam,
    first_choice") and OPERATING.md names ("with `record=` every layer's arrays and the
    logits"); the README's "Python API" section does not show it (README.md, deviations). A
    request on which `extend` raises RangeConditionFailed is recorded as failed with that
    message. This is the package's computation, not cp_prove's."""
    lines = host(job["requests_file"]).read_text().splitlines()
    requests = [json.loads(ln) for ln in lines if ln.strip()]
    policy = host(FIT_CONFIG) / "policy.txt"
    t = window_of(policy)
    for r in requests:
        request_words(r["prompt"], r["reply"], t)  # refuses a request that does not fit
    k = int(job.get("top_k", 0))
    work = workdir(host("/io/state/score"))
    out = host(job["out_dir"])
    out.mkdir(parents=True, exist_ok=True)
    phases: list[dict] = []
    model, options = integer_model_folder(job, work, phases)
    started = time.monotonic()
    listed = work / "requests.jsonl"
    listed.write_text("".join(json.dumps(r) + "\n" for r in requests))
    log = work / "score.log"
    argv = [IM_PYTHON, "-B", "-c", SCORE_PY, str(model), str(listed), str(out), str(k),
            str(logit_scale(policy) if k else 0), options]  # fmt: skip
    if run(argv, job, work, log) != 0:
        raise SystemExit(f"flashprove: the integer model exited non-zero, last line "
                         f"{last_line(log)!r}")  # fmt: skip
    phases.append({"name": "score", "seconds": time.monotonic() - started})
    docs = [json.loads((out / f"{i}.json").read_text()) for i in range(len(requests))]
    length = len(requests[0]["reply"]) if requests else 0
    return {**base("score"), "phases": phases,
            "scores": {"dir": job["out_dir"].rstrip("/"), "requests": len(requests),
                       "positions": length, "top_k": k,
                       "failed": [i for i, d in enumerate(docs) if "failed" in d]}}  # fmt: skip


def prove(job: dict) -> dict:  # noqa: PLR0915
    size, batches = job["batch_size"], job["batches"]
    prompts = [json.loads(ln) for ln in host(job["prompts_file"]).read_text().splitlines()]
    prompts = prompts[: size * batches]
    tokens, length = job["shape"]["prompt_tokens"], job["shape"]["output_tokens"]
    if len(prompts) < size * batches or any(len(p) != tokens for p in prompts):
        raise SystemExit(f"flashprove: need {size * batches} prompts of {tokens} token ids")
    [isk_tar] = job["prover_files"]
    work = workdir(host("/io/state/prove"))
    phases: list[dict] = []
    if control_id(job) == "P1":
        # cp_prove loads the weights from the directory cp_commit recorded, not from /models
        # (U/weight_sums/README.md L178-180): W' goes there, W's wsums.txt and fold.txt stay
        for name in SHARDS:
            clone(host(MODEL) / name, host(WEIGHTS) / name)
        WARNINGS.append("control job P1: the weight files cp_prove reads are W' from /models, "
                        "committed as W")  # fmt: skip
    # one output token: the next token after a full window, which cp_prove states (v0.1); a
    # longer reply: the integer model's own, then the whole of it checked (Level 1)
    replies = generate(job, prompts, length, work, phases) if length > 1 else None
    t = window_of(host(FIT_CONFIG) / "policy.txt") if replies else tokens
    with tarfile.open(host(isk_tar)) as tar:
        # "tar", not "data": the data filter gives directories the default mode, and cp_prove
        # refuses a key directory that is not 0700 as cp_commit made it (refusal cp-isk)
        tar.extractall(work, filter="tar")
    spool = private(work / "spool")
    private(private(spool / "in") / ".tmp")
    pending: dict[str, int] = {}
    for i, prompt in enumerate(prompts):  # laid in order: cp_prove takes the oldest first
        words = request_words(prompt, replies[i], t) if replies else [*prompt, t - 1, t]
        data = pack(words) + os.urandom(32)
        rid = hashlib.sha256(b"p258-spool-req-1" + data).hexdigest()
        (spool / "in/.tmp" / rid).write_bytes(data)
        os.link(spool / "in/.tmp" / rid, spool / "in" / f"{rid}.req")
        os.unlink(spool / "in/.tmp" / rid)
        pending[rid] = i
    proofs_dir = host("/io/proofs")
    proofs_dir.mkdir(parents=True, exist_ok=True)
    proofs: list[dict] = []
    failed: list[int] = []

    def sweep() -> None:
        for rid, i in list(pending.items()):
            out = spool / "out" / rid
            if out.with_suffix(".proof").exists():
                y = out.with_suffix(".y").read_bytes()
                tmp = proofs_dir / f".tmp-req-{i}"
                tmp.mkdir()
                for part, src in zip(PARTS, (".y", ".proof"), strict=True):
                    os.link(out.with_suffix(src), tmp / part)
                os.rename(tmp, proofs_dir / f"req-{i}")
                # the reply the integer model wrote, or the next token cp_prove states in .y
                claimed = replies[i] if replies else [int.from_bytes(y, "little")]
                proofs.append({"proof_id": f"req-{i}", "request_index": i, "parts": PARTS,
                               "claimed_output": claimed})  # fmt: skip
            elif out.with_suffix(".failed").exists():
                failed.append(i)
            else:
                continue
            del pending[rid]

    argv = [str(BIN / "cp_prove"), "-isk", str(work / "isk"), "-spool", str(spool),
            "-batch", str(size), "-in-step", str(min(6, size)), "-most-batches", str(batches),
            "-memory", MEMORY, *job.get("control_flags", [])]  # fmt: skip
    log = work / "cp_prove.log"
    started = time.monotonic()
    code = run(argv, job, work, log, poll=sweep)
    phases.append({"name": "cp_prove", "seconds": time.monotonic() - started})
    if code != 0 or failed or pending:
        unanswered = sorted(pending.values())
        raise SystemExit(f"flashprove: cp_prove exited {code}, last line {last_line(log)!r}; "
                         f"failed {sorted(failed)}, unanswered {unanswered}")  # fmt: skip
    return {
        **base("prove"),
        "proofs": sorted(proofs, key=lambda p: p["request_index"]),
        "phases": phases,
    }


def verdict(code: int, last: str) -> tuple[str, str | None]:
    """RFC-0005 §Verdict normalisation; anything else is an adapter failure, never a guess."""
    if code == 0 and last == "YES":
        return "accept", "exact-match"
    if code == 0 and last.startswith("WITHIN LIMITS: clipped-gap"):
        return "accept", "clipped-gap"
    if code in VERDICTS:
        return VERDICTS[code], None
    raise SystemExit(f"flashprove: cp_verify exit {code}, last line {last!r}: not documented")


def verify(job: dict) -> dict:
    claimed, request = job["claimed_output"], job["request"]
    if not claimed:
        raise SystemExit("flashprove: no claimed token")
    work = workdir(Path(tempfile.mkdtemp(prefix="flashprove-verify-")) / "work")
    config, leaf = private(work / "config"), private(work / "ivk/leaf")
    for path in map(host, job["verifier_files"]):
        into = leaf.parent if path.name == "key.bin" else leaf
        into = config if path.name in CONFIG_FILES else into
        shutil.copyfile(path, into / path.name)
    if len(claimed) == 1:  # the next token after a full window, in the token file (v0.1)
        words, y, ask = [*request, len(request) - 1, len(request)], claimed, ["-next-token"]
    else:  # the whole reply in the window, every token checked; y unused, so 0 (Level 1)
        words, y, ask = request_words(request, claimed, window_of(config / "policy.txt")), [0], []
    (work / "request.req").write_bytes(pack(words))
    (work / "token.y").write_bytes(pack(y))
    cpus = cpu_count()
    argv = [str(BIN / "cp_verify"), str(config), str(work / "ivk"), str(work / "request.req"),
            str(work / "token.y"), str(host(job["proof_dir"]) / PARTS[1]),
            "-id", job["commitment_id"], *ask, "-j", str(min(256, cpus or 1))]  # fmt: skip
    started = time.monotonic()
    code = run(argv, job, work, work / "stdout", work / "stderr")
    seconds = time.monotonic() - started
    last = last_line(work / "stdout")
    v, policy = verdict(code, last)
    out = {**base("verify"), "verdict": v, "raw_exit_code": code, "seconds": seconds,
           "raw_last_line": last or last_line(work / "stderr")}  # fmt: skip
    shutil.rmtree(work.parent)
    return out | ({"policy": policy} if policy else {})


def gguf_tensors(path: Path) -> tuple[int, dict[str, tuple[int, int]]]:
    """(data start, {name: (type, offset from data start)}) of a GGUF file of version 3: header,
    metadata, tensor table, then the data at the next multiple of `general.alignment` (32 if
    absent) (U/docs/model.md 11.1)."""
    with path.open("rb") as f:

        def read(fmt: str) -> int | float | bool:
            return struct.unpack(fmt, f.read(struct.calcsize(fmt)))[0]  # type: ignore[no-any-return]

        def string() -> str:
            return f.read(int(read("<Q"))).decode()

        def value(kind: int) -> object:
            if kind == 8:
                return string()
            if kind == 9:
                inner, count = int(read("<I")), int(read("<Q"))
                return [value(inner) for _ in range(count)]
            return read(GGUF_SCALARS[kind])

        if f.read(4) != b"GGUF" or read("<I") != 3:
            raise SystemExit(f"flashprove: {path} is not a GGUF file of version 3")
        n_tensors, n_meta = int(read("<Q")), int(read("<Q"))
        meta = {string(): value(int(read("<I"))) for _ in range(n_meta)}
        tensors = {}
        for _ in range(n_tensors):
            name = string()
            for _ in range(int(read("<I"))):
                read("<Q")
            tensors[name] = (int(read("<I")), int(read("<Q")))
        align = int(meta.get("general.alignment", 32))  # type: ignore[call-overload]
        return -(-f.tell() // align) * align, tensors


def q4k_step(block: bytes) -> int | None:
    """The first sub-block j < 4 of a Q4_K block whose 6-bit scale sc = b[j] mod 64 can rise by
    one and whose step moves an element: h not 0 and some 4-bit code c of the sub-block not 0
    (v = RN32(RN32(RN32(h sc) c) - RN32(h_min mn)), U/docs/model.md L377-L393). None if none."""
    if block[0:2] == b"\x00\x00" or block[0:2] == b"\x00\x80":
        return None
    for j in range(4):
        codes = block[16 + 32 * (j // 2) : 48 + 32 * (j // 2)]
        nibbles = [b >> 4 if j % 2 else b & 15 for b in codes]
        if block[4 + j] & 63 < 63 and any(nibbles):
            return j
    return None


def perturb(job: dict) -> dict:
    """RFC-0018 AD-5 on a CPU: W' is the workload's five GGUF files with one Q4_K block scale of
    a dense attention tensor of block 0 raised by one step, written to out_dir; the change is
    shown by upstream's own digest tool, bin/weight_sums, whose wsums.txt for W' must differ
    from the published one for W (the commitment ID cannot show it: cp_commit draws a fresh
    seed, U/examples/accepted-proof/README.md L75)."""
    if "Q4_K" not in job["change"]:
        raise SystemExit(f"flashprove: perturb makes a Q4_K scale step, not {job['change']!r}")
    src = host(job["model_dir"]) / Path(MODEL).name
    out = host(job["out_dir"]) / Path(MODEL).name
    out.mkdir(parents=True, exist_ok=True)
    found = None
    for name in SHARDS:
        start, tensors = gguf_tensors(src / name)
        for tensor in ATTENTION:
            if tensor in tensors and tensors[tensor][0] == Q4_K and found is None:
                found = (name, tensor, start + tensors[tensor][1])
    if found is None:
        raise SystemExit(f"flashprove: none of {ATTENTION} is stored as Q4_K")
    shard, tensor, at = found
    with (src / shard).open("rb") as f:
        for k in range(1 << 20):
            f.seek(at + k * Q4_K_BYTES)
            block = f.read(Q4_K_BYTES)
            j = q4k_step(block) if len(block) == Q4_K_BYTES else None
            if j is not None:
                break
        else:
            raise SystemExit(f"flashprove: no Q4_K block of {tensor} has a scale step that moves")
    offset, old = at + k * Q4_K_BYTES + 4 + j, block[4 + j]
    new = (old & 0xC0) | ((old & 63) + 1)
    for name in SHARDS:
        clone(src / name, out / name)
    with (out / shard).open("r+b") as f:
        f.seek(offset)
        f.write(bytes([new]))
    work = workdir(host("/io/perturb-work"))
    wsums = work / "wsums.txt"
    argv = [str(SRC / "bin/weight_sums"), "--eres", "10", "--threads", str(min(64, cpu_count())),
            "--out", str(wsums), *(str(out / n) for n in SHARDS)]  # fmt: skip
    log = work / "weight_sums.log"
    if run(argv, job, work, log, at=SRC) != 0:
        raise SystemExit(f"flashprove: weight_sums exited non-zero, last line {last_line(log)!r}")
    digest_w, digest_w_prime = (
        expected()["model/wsums.txt"],
        hashlib.sha256(wsums.read_bytes()).hexdigest(),
    )
    if digest_w_prime == digest_w:
        raise SystemExit("flashprove: the scale step left every committed integer as it was")
    return {**base("perturb"), "perturbation": {
        "tensor": tensor, "index": k * 256 + 32 * j,
        "old": bytes([old]).hex(), "new": bytes([new]).hex(),
        "unit": f"one step of the 6-bit scale sc of sub-block {j} of Q4_K block {k} (elements "
                f"{k * 256 + 32 * j} to {k * 256 + 32 * j + 31}), byte {offset} of {shard}",
        "digest_w": f"sha256:{digest_w}", "digest_w_prime": f"sha256:{digest_w_prime}",
        "digest_tool": "bin/weight_sums: wsums.txt, the SHA-256 of every committed tensor's "
                       "integers; W's is the published one (examples/maverick/expected.txt)"}}


def main() -> int:
    sub, job_path, out_path = sys.argv[1:4]
    job = json.loads(host(job_path).read_text())
    if job.get("subcommand") != sub:
        raise SystemExit(f"flashprove: job.json is for {job.get('subcommand')!r}, not {sub!r}")
    handlers = {"info": info, "setup": setup, "commit": commit, "prove": prove, "verify": verify,
                "perturb": perturb, "score": score}  # fmt: skip
    if sub not in handlers:
        raise SystemExit(f"flashprove: no subcommand {sub!r}")
    WARNINGS.clear()
    out = handlers[sub](job)
    out["warnings"] = [*out.get("warnings", []), *WARNINGS]
    host(out_path).write_text(json.dumps(out, sort_keys=True, indent=2) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
