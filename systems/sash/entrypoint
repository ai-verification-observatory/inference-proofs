def commit(job: dict) -> dict:
    """model-commitment.sh step 1 over a commitment sequence: upstream's own corpus, extracted
    the way a sequence run extracts it (no `--ids`: the corpus's first tokens). Then the kernel
    store from that sequence's witness and the sweep, and one CUDA build (README.md §Kernels);
    the commitment covers the verifier files alone, as before. With `setup_state`, the state a
    setup run's commit left is restored under /io/state and is checked, not made again. A MODEL
    control's commit (W' at /models, RFC-0008 C3) makes the commitment only: no proof is ever
    made from W' state (P1 proves from the session's own), so it emits and builds nothing."""
    if "setup_state" in job:
        return reuse(job)
    control = isinstance(job.get("control"), dict)
    t0 = time.monotonic()
    g = geometry(job["shape"], model_layers())
    wit = STATE + "/commit-witness"
    for d in (ZK_OUT, wit):
        host(d).mkdir(parents=True, exist_ok=True)
    plan, emit_txt, pins = witness_and_plan(g, wit, [])
    t1 = time.monotonic()
    if missing := [f for f in PROVER if not host(f).is_file()]:  # before model-roots and build
        raise SystemExit(f"sash: the extraction wrote no {missing}")
    roots, grid = VERIFIER
    run([SIMD, "model-roots", "--plan", plan, "--pins", f"{SHARED} {pins}", "--out", roots],
        out=STATE + "/model-roots.out.json")  # fmt: skip
    write_json(grid, g)
    t2 = time.monotonic()
    if control:
        shutil.rmtree(host(wit))
        phases = {"witness": t1 - t0, "model_roots": time.monotonic() - t1}
        log("commit: a MODEL control's commitment: no kernel emitted or built; seconds "
            + ", ".join(f"{k} {v:.1f}" for k, v in phases.items()))  # fmt: skip
        return commit_out(phases, None)
    sweep = prepare_kernels(plan, emit_txt, pins)
    t3 = time.monotonic()
    shutil.rmtree(host(wit))  # tens of GB of activations; the plan and pins are in no file kept
    t4 = time.monotonic()  # the deletion counts in model_roots, as in v1.0
    _, build_seconds = ensure_built()
    phases = {"witness": t1 - t0, "model_roots": t2 - t1 + t4 - t3, "kernels_emit": t3 - t2,
              "kernels_build": build_seconds}  # fmt: skip
    log("commit: seconds " + ", ".join(f"{k} {v:.1f}" for k, v in phases.items()))
    kernels = {**store_facts(store()), **sweep}
    write_json(KERNELS_RECORD, kernels)
    return commit_out(phases, kernels)


def reuse(job: dict) -> dict:
    """commit over a restored setup (README.md §Setup): the state a setup run's commit left,
    restored by the harness under /io/state. Nothing is extracted, derived, emitted or built.
    The check: both verifier files and both prover files are there, the verifier files hash to
    the setup's commitment id, the grid is this request's, the store's build key is the one the
    setup names and the one the CUDA binary was built from (`kernels.done`), the binary is
    there and its library carries this card's architecture. Any failure stops the run; it never
    falls back to making the state again."""
    t0 = time.monotonic()
    want = job["setup_state"]
    if isinstance(job.get("control"), dict):  # a MODEL control commits W', never the setup's W
        raise SystemExit("sash: a control commit over a changed model is never a restored setup")
    if missing := [f for f in [*VERIFIER, *PROVER, CUDA, BUILD + "/kernels.done"]
                   if not host(f).is_file()]:  # fmt: skip
        raise SystemExit(f"sash: the restored setup has no {missing}")
    if (got := commitment_of(VERIFIER)) != want["commitment_id"]:
        raise SystemExit(f"sash: the restored verifier files hash to {got}, not the setup's "
                         f"{want['commitment_id']}")  # fmt: skip
    grid = json.loads(host(VERIFIER[1]).read_text())
    if grid != json.loads(json.dumps(geometry(job["shape"], model_layers()))):
        raise SystemExit(f"sash: the restored grid {grid} is not this request's")
    state, built = store(), host(BUILD + "/kernels.done").read_text()
    if not state[0] or not state[1]:
        raise SystemExit(f"sash: the restored kernel store is empty ({store_line(state)})")
    if built != state[2] or want.get("build_key", state[2]) != state[2]:
        raise SystemExit(f"sash: the restored store's build key is {state[2]}; the binary was "
                         f"built from {built} and the setup names "
                         f"{want.get('build_key')}")  # fmt: skip
    check_arch()
    kernels = store_facts(state)
    if host(KERNELS_RECORD).is_file():  # the setup's own sweep record, kept with the store
        kept = json.loads(host(KERNELS_RECORD).read_text())
        kernels.update({k: v for k, v in kept.items() if k not in kernels})
    phases = {"setup_check": time.monotonic() - t0}
    log(f"commit: reused the setup {want['commitment_id']}; store {store_line(state)}; "
        f"seconds setup_check {phases['setup_check']:.1f}")
    return commit_out(phases, kernels)


def log(message: str) -> None:
    """A line for the step's stderr, which the harness keeps (logs/<step>.stderr)."""
    print(f"sash: {message}", file=sys.stderr, flush=True)


def line_args(line: str) -> tuple[str, ...]:
    """A plan or emit line as emission arguments: its `--ser-tag` removed (sequence-job.sh)."""
    args = shlex.split(line)
    if "--ser-tag" in args:
        i = args.index("--ser-tag")
        del args[i : i + 2]
    return tuple(args)


def plan_lines(plan: str) -> list[tuple[str, ...]]:
    return sorted({line_args(ln) for ln in host(plan).read_text().splitlines()
                   if ln.strip() and not ln.startswith("#")})  # fmt: skip


def emit_lines(plan: str, emit: str) -> list[tuple[str, ...]]:
    """sequence-job.sh step 5's list: every line of `emit.txt` (plan.py's one line per emit key)
    and every head line of the plan, since the feed kernels of a head are per block."""
    lines = [ln for ln in host(emit).read_text().splitlines() if ln and not ln.startswith("#")]
    head = re.compile(r"--ser-tag [A-Za-z0-9_]*head")
    lines += [ln for ln in host(plan).read_text().splitlines()
              if not ln.startswith("#") and head.search(ln)]  # fmt: skip
    return sorted({line_args(ln) for ln in lines})


def pinned(argv: list[str], flag: str) -> int | None:
    """The value upstream reads for `flag`: its last occurrence (cli.rs arg_pair)."""
    at = [i for i, a in enumerate(argv[:-1]) if a == flag]
    return int(argv[at[-1] + 1]) if at else None


def emit(lines: list[tuple[str, ...]], pins: str, flags: list[str],
         sweep: tuple[str, int] | None = None) -> tuple[int, list[str]]:  # fmt: skip
    """`cudaemit` and `genemit` over `lines` into the one kernel store, as sequence-job.sh step 5
    runs them. With `sweep` = (flag, value), each line is emitted with that pin set to `value`
    where upstream reads it, and only where `value` is above the pin the line is emitted at
    (the prover admits a pin down to the witness's own; commit widens upward only). Returns the
    number of runs and one line per refused lowering: a refusal is recorded and never fatal
    (sequence-job.sh); a shape left without its kernel then panics in the proof."""
    runs, refused = 0, []
    for args in lines:
        argv = [*SHARED.split(), *pins.split(), *flags, *args]
        if sweep is not None:
            flag, value = sweep
            own = pinned(argv, flag)
            if own is not None and value <= own:
                continue
            at = [i for i, a in enumerate(argv[:-1]) if a == flag]
            if at:
                argv[at[-1] + 1] = str(value)
            else:
                argv += [flag, str(value)]
        for cmd, opts in (("cudaemit", ["--block", "256", "--min-blocks", "2"]),
                          ("genemit", ["--families", KERNEL_FAMILIES])):  # fmt: skip
            p = run([SIMD, cmd, *argv, *opts, "--out", GEN], check=False)
            runs += 1
            if p.returncode != 0:
                refused.append(f"{cmd} exited {p.returncode} on `{shlex.join(args)}`"
                               f"{f' at {sweep[0]} {sweep[1]}' if sweep else ''}: "
                               f"{refusal_line(p.stderr)[:300]}")  # fmt: skip
    return runs, refused


def store() -> tuple[int, int, str, str]:
    """The kernel store: its constraint kernels (`shapes.json`, cudagen.rs emit_cmd), its
    generation shapes (`gen_shapes.json`, gen_emit_cmd), the build key and the shape set.
    The build key is sha256 over `<file name>\\t<sha256>` lines in name order. A second
    emission of stored shapes rewrites every file byte for byte except the two manifests, which
    also carry the last run's `source` (a witness path), `components` and new-shape count; of
    those the key takes only the `families` list, which is what the two install scripts read.
    The files keep shapes in first-seen order, so two sessions holding the same shapes reached
    in another order have two keys; the shape set, sha256 over the sorted
    `<list>\\t<family>\\t<sha256 of the shape's Ir>` lines, is the same for both."""
    root, lines = host(GEN), []
    for p in sorted(root.iterdir()) if root.is_dir() else []:
        if not p.is_file():
            continue
        body = p.read_bytes()
        if p.name in ("manifest.json", "gen_manifest.json"):
            with contextlib.suppress(ValueError, AttributeError):  # else digested as it is
                body = json.dumps(json.loads(body).get("families"), sort_keys=True).encode()
        lines.append(f"{p.name}\t{hashlib.sha256(body).hexdigest()}\n")

    def count(name: str) -> int:
        return len(json.loads((root / name).read_text())) if (root / name).is_file() else 0

    def shape_set() -> str:
        try:  # each entry is (family, first-seen name, Ir), cudagen.rs L2556
            keys = sorted(f"{name}\t{family}\t" + hashlib.sha256(
                json.dumps(ir, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
                for name in ("shapes.json", "gen_shapes.json") if (root / name).is_file()
                for family, _, ir in json.loads((root / name).read_text()))  # fmt: skip
        except (ValueError, TypeError) as e:  # a log line only, never a stop
            return f"unreadable ({e})"
        return "sha256:" + hashlib.sha256("".join(k + "\n" for k in keys).encode()).hexdigest()

    digest = "sha256:" + hashlib.sha256("".join(lines).encode()).hexdigest()
    return count("shapes.json"), count("gen_shapes.json"), digest, shape_set()


def store_line(state: tuple[int, int, str, str]) -> str:
    return (f"{state[0]} constraint kernels, {state[1]} generation shapes, "
            f"build key {state[2]}, shape set {state[3]}")  # fmt: skip


def store_facts(state: tuple[int, int, str, str]) -> dict[str, object]:
    return {"constraint_kernels": state[0], "generation_shapes": state[1], "build_key": state[2],
            "shape_set": state[3]}  # fmt: skip


def report(what: str, lines: int, runs: int, refused: list[str], quiet: bool = False) -> None:
    log(f"kernels: {what}: {lines} lines, {runs} emitter runs, {len(refused)} refused")
    for r in refused[: 5 if quiet else 50]:
        log(f"  refused: {r}")
    if len(refused) > (5 if quiet else 50):
        log(f"  ... and {len(refused) - (5 if quiet else 50)} more refused")


def split(need: int) -> tuple[int, int]:
    """params_of's limbs for an accumulator that needs `need` bits: the low limb clamped to
    MIN_LOG_ROWS..16, the high limb the rest and at least MIN_LOG_ROWS (cli.rs L1274-L1281)."""
    lo = min(max(need, 4), 16)
    return lo, max(need - lo, 4)


def ao_points() -> list[tuple[str, int, int, int, bool]]:
    """The attention output's (form, lo, hi, rem, denp2) that params_of chooses for each
    (acc_bits, e_hi, rem) of AO_BOX: the offset form's limbs carry acc_bits + 1, the magnitude
    form's acc_bits; the product form is taken when the magnitude window would pass 31 bits,
    the magnitude form when the offset window would; denp2 when q_bits + rem > 30 (cli.rs
    L1274-L1325). In first-seen order, each once."""
    points: dict[tuple[str, int, int, int, bool], None] = {}
    widths, highs, rems = AO_BOX
    for a in widths:
        for e_hi in highs:
            for rem in rems:
                if a > rem + 6:
                    continue
                (lo_off, hi_off), (lo_mag, hi_mag) = split(a + 1), split(a)
                prod = 1 + lo_mag + hi_mag + e_hi > 31
                mag = prod or 1 + lo_off + hi_off + e_hi > 31
                lo, hi = (lo_mag, hi_mag) if mag else (lo_off, hi_off)
                form = "product" if prod else "magnitude" if mag else "offset"
                points[(form, lo, hi, rem, AO_Q_BITS + rem > 30)] = None
    return list(points)


def synthetic_point(point: tuple[str, int, int, int, bool]) -> tuple[str, int, int, int, bool]:
    """`point` as the synthetic segment admits it (SYNTH_AO_ACC): unchanged when its limbs reach
    the segment's accumulator or its form is the offset one, whose key holds the high limb
    itself; else the narrowest high limb >= SYNTH_AO_ACC - lo with the same equalities. A point
    no such limb keeps (its high limb equals its low one) stays as it is, and is refused."""
    form, lo, hi, rem, denp2 = point
    if form == "offset" or lo + hi >= SYNTH_AO_ACC:
        return point

    def equal(h: int) -> tuple[bool, ...]:
        return (h == rem, h == lo, *((h == 30 - lo,) if form == "product" else ()))

    wider = [h for h in range(max(SYNTH_AO_ACC - lo, 4), 32) if equal(h) == equal(hi)]
    return (form, lo, wider[0], rem, denp2) if wider else point


def ao_flags(point: tuple[str, int, int, int, bool]) -> list[str]:
    form, lo, hi, rem, denp2 = point
    return ["--ao-acc-lo-bits", str(lo), "--ao-acc-hi-bits", str(hi), "--ao-rem-bits", str(rem),
            *(["--ao-acc-mag"] if form != "offset" else []),
            *(["--ao-acc-prod"] if form == "product" else []),
            *(["--ao-denp2"] if denp2 else [])]  # fmt: skip


def is_head(args: tuple[str, ...]) -> bool:
    """A head line reads a head dump (plan.py head_line: `<head>_B<b>`)."""
    return "--witness" in args and Path(args[args.index("--witness") + 1]).name.startswith("head")


def emit_forms(lines: list[tuple[str, ...]], pins: str) -> tuple[int, list[str]]:
    """The attention output's constraint kernels in the forms the data may take (the constraint
    shape sees the form and, in the product form, the low limb; air.rs L155, L189-L192): one
    `cudaemit` per form, `--ao-acc-mag` and `--ao-acc-prod --ao-acc-lo-bits L` for each L of
    AO_PROD_LO, on the first line of `lines` that admits it (params_of sizes the high limb to
    the line's own accumulator, cli.rs L1278-L1281). Layer lines are tried before head lines."""
    order = [a for a in lines if not is_head(a)] + [a for a in lines if is_head(a)]
    forms = [["--ao-acc-mag"]] + [["--ao-acc-prod", "--ao-acc-lo-bits", str(lo)]
                                  for lo in AO_PROD_LO]  # fmt: skip
    runs, refused = 0, []
    for form in forms:
        last = ""
        for args in order:
            p = run([SIMD, "cudaemit", *SHARED.split(), *pins.split(), *form, *args, "--block",
                     "256", "--min-blocks", "2", "--out", GEN], check=False)  # fmt: skip
            runs += 1
            if p.returncode == 0:
                break
            last = refusal_line(p.stderr)[:300]
        else:
            refused.append(f"cudaemit `{shlex.join(form)}` on every line: {last}")
    return runs, refused


def emit_synthetic(family: str, flag_sets: list[list[str]]) -> tuple[int, list[str]]:
    """`genemit` on the synthetic segment (SYNTH) for one family, once per flag set; a refusal
    (the segment's own pins are the floor every override must clear, cli.rs L1298-L1299,
    L1317-L1320, L1376-L1379) is recorded and never fatal."""
    refused = []
    for flags in flag_sets:
        p = run([SIMD, "genemit", *SYNTH.split(), *flags, "--families", family, "--out", GEN],
                check=False)  # fmt: skip
        if p.returncode != 0:
            refused.append(f"genemit {family} `{shlex.join(flags)}`: "
                           f"{refusal_line(p.stderr)[:300]}")  # fmt: skip
    return len(flag_sets), refused


def prepare_kernels(plan: str, emit_txt: str, pins: str) -> dict[str, object]:
    """commit's kernel store (README.md §Kernels), emitted before the commitment sequence's
    witness is deleted. From that witness: (a) the lines a reply's own emission runs
    (sequence-job.sh step 5 on this plan); (b) every other line of the plan (plan.py keys a
    line by its prefix, table width, head, flags and the attention output's form, not its limb
    widths); (c) the lines of (a) with `--ao-rem-bits` and `--fold-rem-bits` widened step by
    step above the pin each is emitted at, up to the widest the prover admits. Then the
    data-dependent families over their bound, through params_of's override flags: (d) the
    attention output's constraint kernels in the magnitude form and in the product form at
    each low limb, on the commitment's own lines; (e) its generation shapes for every point of
    AO_BOX and (f) the fold's for every `--fold-rem-bits` up to its cap, on the synthetic
    segment. A refusal is recorded and never fatal. Returns what the sweep did."""
    host(GEN).mkdir(parents=True, exist_ok=True)
    total, refusals = 0, 0

    def done(what: str, lines: int, runs: int, refused: list[str], quiet: bool = False) -> None:
        nonlocal total, refusals
        total, refusals = total + runs, refusals + len(refused)
        report(what, lines, runs, refused, quiet)

    reps = emit_lines(plan, emit_txt)
    done("(a) commitment plan, the lines a reply emits", len(reps), *emit(reps, pins, []))
    log(f"kernels: store after (a): {store_line(store())}")
    known = set(reps)
    rest = [a for a in plan_lines(plan) if a not in known]
    done("(b) commitment plan, every other line", len(rest), *emit(rest, pins, []))
    for flag, cap in (("--ao-rem-bits", AO_REM_CAP), ("--fold-rem-bits", FOLD_REM_CAP)):
        owns = [v for a in reps if (v := pinned([*pins.split(), *a], flag)) is not None]
        start = min(owns, default=cap) + 1
        runs, refused = 0, []
        for value in range(start, cap + 1):
            r, f = emit(reps, pins, [], sweep=(flag, value))
            runs, refused = runs + r, refused + f
        values = f"{start}..{cap}" if start <= cap else "none above the pins"
        done(f"(c) {flag} {values} on the lines a reply emits", len(reps), runs, refused,
             quiet=True)  # fmt: skip
    c, g, _, _ = store()
    if not c or not g:
        raise SystemExit(f"sash: the commitment's lines left {c} constraint kernels and {g} "
                         "generation shapes; every emission was refused (see the lines above)")
    lines = reps + rest
    done("(d) attention-output forms, constraint kernels", len(lines), *emit_forms(lines, pins),
         quiet=True)  # fmt: skip
    points = list(dict.fromkeys(synthetic_point(p) for p in ao_points()))
    done(f"(e) attention output over its bound, {len(points)} points, synthetic segment", 0,
         *emit_synthetic("zk_attn_out_eval", [ao_flags(p) for p in points]), quiet=True)
    folds = [["--fold-rem-bits", str(v)] for v in range(1, FOLD_REM_CAP + 1)]
    done(f"(f) fold --fold-rem-bits 1..{FOLD_REM_CAP}, synthetic segment", 0,
         *emit_synthetic("zk_dequant_eval", folds), quiet=True)
    state = store()
    log(f"kernels: store after commit: {store_line(state)}")
    return {"emitter_runs": total, "refused": refusals, "flags": list(OVERRIDE_FLAGS),
            "synthetic_segment": SYNTH}  # fmt: skip


def ensure_built() -> tuple[bool, float]:
    """Install the store and rebuild the CUDA backend unless the binary was built from a store
    of this same content (the digest is keyed on no path). Returns whether a build ran and its
    seconds."""
    state = store()
    marker = host(BUILD + "/kernels.done")
    if marker.is_file() and marker.read_text() == state[2] and host(CUDA).is_file():
        log(f"kernels: build skipped, the installed store is this one ({state[2]})")
        return False, 0.0
    log(f"kernels: build: installing {store_line(state)}")
    started = time.monotonic()
    build()
    marker.write_text(state[2])
    seconds = time.monotonic() - started
    log(f"kernels: build ran in {seconds:.1f} s; installed {state[2]}")
    return True, seconds


def build() -> None:
    """sequence-job.sh step 5 and tools/gate/on-card.sh: install the store into a copy of the
    vendored library, rebuild the CUDA backend and check that the library carries this card's
    architecture."""
    gen, src = GEN, BUILD + "/src"
    host(src).mkdir(parents=True, exist_ok=True)
    run(["cp", "-a", *(f"{SRC}/{p}" for p in ("Cargo.toml", "Cargo.lock", "rust-toolchain.toml",
                                              "prover", "nitroo")), src])  # fmt: skip
    host(src + "/.source-commit").write_text(f"{UPSTREAM_COMMIT} dirty\n")  # build.rs
    k = src + "/prover/kernels"
    run(["python3", f"{k}/install_constraint_kernels.py", "--fork", f"{src}/nitroo", "--gen", gen])
    run(["python3", f"{k}/install_witness_gen_kernels.py", "--fork", f"{src}/nitroo", "--gen",
         gen, "--src", k])  # fmt: skip
    run(["cp", f"{gen}/cudakernels.rs", f"{gen}/gencudakernels.rs", f"{src}/prover/src/"])
    arch = card_arch()
    cargo = BUILD + "/cargo"  # writable CARGO_HOME over the image's fetched registry
    host(cargo).mkdir(parents=True, exist_ok=True)
    if not host(cargo + "/registry").is_symlink():
        os.symlink("/opt/cargo/registry", host(cargo + "/registry"))
    run(["cargo", "build", "--release", "--locked", "--offline", "-p", "zk-prover", "--features",
         "cuda"], cwd=src, env={"CARGO_HOME": cargo, "CARGO_TARGET_DIR": BUILD + "/t-cuda",
                                "CUDAARCHS": arch})  # fmt: skip
    check_arch(arch)


def card_arch() -> str:
    """This card's architecture, as tools/gate/on-card.sh reads it (compute capability 9.0 is
    90)."""
    cap = run(["nvidia-smi", "--query-gpu=compute_cap", "--format=csv,noheader"]).stdout
    arch = cap.strip().splitlines()[0].replace(".", "") if cap.strip() else ""
    if not arch.isdigit():
        raise SystemExit(f"sash: nvidia-smi reported no compute capability ({cap!r})")
    return arch


def check_arch(arch: str | None = None) -> None:
    """The built library carries this card's `sm_` code: the CMake fallback trap
    (tools/gate/README.md), and a binary restored from a setup made on another card."""
    arch = arch or card_arch()
    libs = sorted(host(BUILD + "/t-cuda/release/build").glob("stwo-*/out/libstwo_cuda.a"))
    if not libs:
        raise SystemExit("sash: the CUDA build left no libstwo_cuda.a")
    lib = "/io" + str(libs[0])[len(str(host("/io"))) :]
    elf = run(["cuobjdump", "--list-elf", lib]).stdout
    if f"sm_{arch}" not in elf:
        raise SystemExit(f"sash: {lib} carries no sm_{arch} code; refusing to prove")


def fold_binding(slices: list[dict]) -> dict:
    """The binding table over every slice: an edge is bound only where every proof binds it.
    Each edge is named as the claim card names it."""
    rank = {"bound": 0, "absent": 1, "unbound": 2}
    card = dict(enumerate(CARD_EDGES, 1))
    edges: dict[str, str] = {}
    skips: set[str] = set()
    for doc in slices:
        prov = doc["provenance"]
        skips.update(prov.get("unsound_skips") or [])
        for e in prov["binding"]["edges"]:
            name = card.get(e["n"], "")
            if not name.startswith(f"{e['n']} {e['edge']}"):
                raise SystemExit(f"sash: upstream edge {e['n']} {e['edge']!r} is not in the "
                                 "claim card's binding table")  # fmt: skip
            if rank.get(e["state"], 2) >= rank.get(edges.get(name, "bound"), 2):
                edges[name] = e["state"]
    return {"edges": edges, "all_bound": all(v == "bound" for v in edges.values()),
            "unsound_skips": sorted(skips)}  # fmt: skip


def reply_kernels(name: str, plan: str, emit_txt: str, pins: str,
                  flags: list[str]) -> tuple[dict[str, float], str | None]:  # fmt: skip
    """sequence-job.sh step 5 for one reply into the session's store, and a rebuild only when
    that changed the store. Returns the two phases' seconds (`kernels_build` is 0 when no build
    ran) and, when the reply had to build, a warning that says what it added."""
    t = time.monotonic()
    before = store()
    lines = emit_lines(plan, emit_txt)
    runs, refused = emit(lines, pins, flags)
    after = store()
    seconds = time.monotonic() - t
    report(f"{name}, the reply's own emission", len(lines), runs, refused)
    log(f"kernels: {name}: the emission added {after[0] - before[0]} constraint kernels and "
        f"{after[1] - before[1]} generation shapes; store {store_line(after)}")
    built, build_seconds = ensure_built()
    log(f"kernels: {name}: build {'ran' if built else 'skipped'}")
    warning = (f"{name}: the reply's emission added {after[0] - before[0]} constraint kernels "
               f"and {after[1] - before[1]} generation shapes the store lacked, so the backend "
               f"was rebuilt in {build_seconds:.1f} s") if built else None  # fmt: skip
    return {"kernels_emit": seconds, "kernels_build": build_seconds}, warning


def prove(job: dict) -> dict:
    flags = list(job.get("control_flags", []))  # only from control_flags (RFC-0005)
    g = geometry(job["shape"], model_layers())
    env = harness_env()
    prompts = host(job["prompts_file"]).read_text().splitlines()
    count = job["batch_size"] * job["batches"]
    if len(prompts) < count:
        raise SystemExit(f"sash: {len(prompts)} prompts for {count} requests")
    p, s, nb = g["prompt"], g["s"], g["blocks"]
    proofs_dir, out = host("/io/proofs"), STATE + "/out"
    proofs_dir.mkdir(parents=True, exist_ok=True)
    host(out).mkdir(parents=True, exist_ok=True)
    phases: dict[str, float] = {}
    proofs, slices, warnings = [], [], []
    cpus = len(os.sched_getaffinity(0)) if hasattr(os, "sched_getaffinity") else 16
    for i in range(count):
        if len(json.loads(prompts[i])) != p:
            raise SystemExit(f"sash: prompt {i} is not {p} tokens")
        t = time.monotonic()
        wit = f"{STATE}/witness-{i}"
        host(wit).mkdir(parents=True, exist_ok=True)
        # the greedy continuation, decoded one token past the block and shifted (shift_ids.py)
        run([*UV, "-c", PROMPT_PY, ZK_OUT + "/tokens.npz", job["prompts_file"], str(i)],
            cwd=HSRC, env=env)  # fmt: skip
        run([*UV, "-m", "harness.witness.gen_ids", "--prefix", str(p), "--offset", "0", "--new",
             str(s + 1), "--spec", SPEC, "--out", f"{wit}/ids_long.npy"],
            cwd=HSRC, env=env)  # fmt: skip
        run([*UV, "-m", "harness.witness.shift_ids", "--ids", f"{wit}/ids_long.npy", "--prefix",
             str(p), "--new", str(s), "--out", f"{wit}/ids.npy"], cwd=HSRC, env=env)  # fmt: skip
        one = {"ids": time.monotonic() - t}  # this reply's own phases, logged below
        t = time.monotonic()
        extra = ["--ids", f"{wit}/ids.npy", "--attn-ranges", ZK_OUT + "/attn_ranges.json"]
        plan, emit_txt, pins = witness_and_plan(g, wit, extra)
        one["witness"] = time.monotonic() - t
        kernel_phases, warning = reply_kernels(f"req-{i}", plan, emit_txt, pins, flags)
        one.update(kernel_phases)
        warnings += [warning] if warning else []
        t = time.monotonic()
        proof_id = f"req-{i}"
        tmp = f"/io/proofs/.tmp-{proof_id}"
        host(tmp).mkdir()
        n = sum(1 for ln in host(plan).read_text().splitlines() if ln and not ln.startswith("#"))
        for lo in range(0, n, SLICE):
            hi, tag = min(lo + SLICE, n), f"{out}/req{i}_slice_{lo:04d}.json"
            r = run([CUDA, "compose-chunks", *SHARED.split(), *pins.split(), *flags, "--plan", plan,
                     "--plan-slice", f"{lo}:{hi}", "--ser-dir", tmp], out=tag,
                    env={"ZK_PIPELINE": "1", "ZK_KERNEL_STORE": GEN,
                         "RAYON_NUM_THREADS": str(min(16, cpus))})  # fmt: skip
            if "kernel fallback:" in r.stderr:  # never a silent host fallback
                raise SystemExit(f"sash: slice {lo}:{hi} evaluated a lookup on the host")
            slices.append(json.loads(host(tag).read_text()))
        shutil.copyfile(host(plan), host(tmp) / "plan.txt")  # the grid the segments form
        last = json.loads((host(tmp) / f"B{nb - 1}L0.fixed.json").read_text())
        claimed = [int(x) for x in last["tok_in"]]
        os.rename(host(tmp), proofs_dir / proof_id)  # atomic release (RFC-0005)
        one["prove"] = time.monotonic() - t
        log(f"req-{i}: seconds " + ", ".join(f"{k} {v:.1f}" for k, v in one.items()))
        for name, seconds in one.items():
            phases[name] = phases.get(name, 0.0) + seconds
        parts = sorted(f.name for f in (proofs_dir / proof_id).iterdir())
        proofs.append({"proof_id": proof_id, "request_index": i, "claimed_output": claimed,
                       "parts": parts})  # fmt: skip
        shutil.rmtree(host(wit))
    write_json("/io/binding.json", fold_binding(slices))
    kernels = {**store_facts(store()), "replies_built": len(warnings)}
    return {**base("prove"), "proofs": proofs, "binding_report": "/io/binding.json",
            "phases": [{"name": k, "seconds": v} for k, v in phases.items()],
            "kernels": kernels, "warnings": warnings}  # fmt: skip


def verdict_of(code: int, stdout: str, stderr: str) -> tuple[str, str]:
    """RFC-0005 §Verdict normalisation for SASH, from `boundary-grid`'s exit status and JSON
    (boundary.rs: exit 0 only when every link chained, every id checked and every segment
    proof verified; 1 otherwise, after the JSON is written). Upstream's verifier alone decides:
    it takes no claimed output (README.md §Level 1; RFC-0018 AD-6)."""
    line = last_line(stderr) or last_line(stdout)
    try:
        r = json.loads(stdout)["result"]
        v, tk = r.get("verified") or {}, r.get("tokens") or {}
        run_, accepted = int(v.get("run", 0)), int(v.get("accepted", 0))
    except (ValueError, KeyError, TypeError, AttributeError):
        return "no_verdict", line
    if code == 1 and accepted < run_:
        return "reject", line  # a segment proof rejected
    if code == 1 and (r.get("all_chain") is False or tk.get("all") is False or r.get("failures")):
        return "reject", line  # the grid check failed
    passed = (code == 0 and r.get("all_chain") is True and v.get("all") is True
              and run_ > 0 and accepted == run_ and tk.get("all") is True)  # fmt: skip
    return ("accept" if passed else "no_verdict"), line


def verify(job: dict) -> dict:
    files = {Path(f).name: f for f in job["verifier_files"]}
    if set(files) != {"model-roots.json", "grid.json"}:
        raise SystemExit(f"sash: verifier files {sorted(files)} are not commit's")
    if commitment_of(list(files.values())) != job["commitment_id"]:
        raise SystemExit("sash: the verifier files do not match commitment_id")
    g = json.loads(host(files["grid.json"]).read_text())
    roots, proof = files["model-roots.json"], job["proof_dir"].rstrip("/")
    write_json("/io/verify/prompt.json", {"ids": job["request"]})
    started = time.monotonic()
    p = run([SIMD, "boundary-grid", "--dir", proof, "--plan", proof + "/plan.txt",
             "--expect-layer-links", str(g["expect_layer_links"]), "--expect-token-links",
             str(g["expect_token_links"]), "--verify", "--prompt", "/io/verify/prompt.json",
             "--verify-calibration", roots, "--expect-model-roots", roots],
            out="/io/verify/grid.json", check=False)  # fmt: skip
    seconds = time.monotonic() - started
    try:
        tok = json.loads(host(f"{proof}/B{g['blocks'] - 1}L0.fixed.json").read_text())["tok_in"]
        proved: list[int] | None = [int(x) for x in tok]
    except (OSError, ValueError, KeyError, TypeError):
        proved = None
    stdout = host("/io/verify/grid.json").read_text()
    verdict, line = verdict_of(p.returncode, stdout, p.stderr)
    # a note, never a verdict (RFC-0018 AD-6): does the claim equal the reply the proof states?
    notes = [] if proved == job["claimed_output"] else [
        "note: claimed_output is not the reply block's ids the proof states (tok_in of "
        f"B{g['blocks'] - 1}L0); boundary-grid takes no claimed output, so this decides nothing"]
    return {**base("verify"), "verdict": verdict, "raw_exit_code": p.returncode,
            "raw_last_line": line, "seconds": seconds, "warnings": notes}  # fmt: skip


def clone(src: Path, dst: Path) -> None:
    """A copy that shares its blocks where the file system can (FICLONE), else a copy."""
    dst.parent.mkdir(parents=True, exist_ok=True)
    with src.open("rb") as i, dst.open("wb") as o:
        try:
            fcntl.ioctl(o.fileno(), 0x40049409, i.fileno())  # FICLONE, linux/fs.h
        except OSError:
            shutil.copyfileobj(i, o, 64 << 20)


def weight_change() -> object:
    """weight_change.py, which lies beside this file (in the image: /opt/sash)."""
    spec = importlib.util.spec_from_file_location(
        "weight_change", Path(__file__).resolve().parent / "weight_change.py")
    if spec is None or spec.loader is None:
        raise SystemExit("sash: no weight_change.py beside the entrypoint")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def perturb(job: dict) -> dict:
    """RFC-0018 AD-5 on a CPU: W' is the model directory with one BF16 weight of layer 0's o_proj
    changed by the fewest BF16 steps that move its int8 code and not its channel's scale, the
    first row that has one (weight_change.py; SASH's load-time quantization, quant.py). SASH has
    no weight digest tool of its own: the digests are of the changed file."""
    if "BF16" not in job["change"]:
        raise SystemExit(f"sash: perturb changes a BF16 weight, not {job['change']!r}")
    wc: Any = weight_change()
    src, out = host(job["model_dir"]), host(job["out_dir"])
    shards = [p for p in sorted(src.glob("*.safetensors"))
              if PERTURB_TENSOR in json.loads(p.read_bytes()[8 : 8 + int.from_bytes(
                  p.read_bytes()[:8], "little")])]  # fmt: skip
    if len(shards) != 1:
        raise SystemExit(f"sash: {PERTURB_TENSOR} is in {len(shards)} safetensors files, not 1")
    shard = shards[0]
    for row in range(1 << 20):
        offset, values = wc.read_row(shard, PERTURB_TENSOR, row)
        if not values:
            raise SystemExit(f"sash: no row of {PERTURB_TENSOR} has a single-weight change")
        change = wc.best_in_row(values)
        if change is not None:
            break
    at = offset + 2 * change.col
    for p in sorted(src.rglob("*")):
        if p.is_file():
            clone(p, out / p.relative_to(src))
    changed = out / shard.relative_to(src)
    with changed.open("r+b") as f:
        f.seek(at)
        f.write(change.after.to_bytes(2, "little"))
    digest = lambda p: "sha256:" + hashlib.sha256(p.read_bytes()).hexdigest()  # noqa: E731
    return {**base("perturb"), "perturbation": {
        "tensor": PERTURB_TENSOR, "index": row * len(values) + change.col,
        "old": change.before.to_bytes(2, "little").hex(),
        "new": change.after.to_bytes(2, "little").hex(),
        "unit": f"{abs(change.steps)} BF16 step(s) {'up' if change.steps > 0 else 'down'} of row "
                f"{row}, column {change.col}: int8 code {change.code_before} to "
                f"{change.code_after} at scale {change.scale!r}, byte {at} of {shard.name}",
        "digest_w": digest(shard), "digest_w_prime": digest(changed), "digest_tool": None}}


def edit_item(text: str, key: str, index: int, old: int, new: int) -> str:
    """`text` with element `index` of the top-level list `key` changed from old to new, every
    other byte as it was; checked by parsing both."""
    m = re.search(rf'"{re.escape(key)}"\s*:\s*\[', text)
    if m is None:
        raise SystemExit(f"sash: no list {key!r}")
    items = list(re.finditer(r"-?\d+", text[m.end() : text.index("]", m.end())]))
    if not 0 <= index < len(items) or int(items[index].group()) != old:
        raise SystemExit(f"sash: {key}[{index}] is not {old}")
    a, b = m.end() + items[index].start(), m.end() + items[index].end()
    edited = text[:a] + str(new) + text[b:]
    want = json.loads(text)
    want[key][index] = new
    if json.loads(edited) != want:
        raise SystemExit(f"sash: editing {key}[{index}] changed more than that value")
    return edited


def mutate_reply(job: dict) -> dict:
    """RFC-0018 AD-6 on a CPU: the proof with reply token `position` changed where boundary-grid
    reads it, and in the field the proof pairs with it, byte for byte otherwise. The reply is
    `tok_in` of the last block's layer-0 statement; each of its ids is checked against the
    argmax the head proved for the position before (`tok_out` of that block's head, or the last
    of the previous block's head at position 0) (U/prover/src/boundary.rs L1148-L1156,
    L1562-L1601; both pinned to their proofs, compose.rs L7845-L7857). Decides nothing."""
    src, out = host(job["proof_dir"]), host(job["out_dir"])
    blocks = sorted(int(m.group(1)) for p in src.glob("B*L0.fixed.json")
                    if (m := re.fullmatch(r"B(\d+)L0\.fixed\.json", p.name))
                    and json.loads(p.read_text()).get("tok_in"))  # fmt: skip
    if not blocks:
        raise SystemExit(f"sash: {src} has no statement with tok_in")
    b, t, token = blocks[-1], int(job["position"]), int(job["token"])
    reply = f"B{b}L0.fixed.json"
    tok_in = json.loads((src / reply).read_text())["tok_in"]
    if not 0 <= t < len(tok_in):
        raise SystemExit(f"sash: position {t} is outside the reply's {len(tok_in)} tokens")
    old = int(tok_in[t])
    head, at = (f"B{b}head.fixed.json", t - 1) if t > 0 else (f"B{b - 1}head.fixed.json", -1)
    if not (src / head).is_file():
        raise SystemExit(f"sash: {src} has no {head}, which emits reply position {t}")
    tok_out = json.loads((src / head).read_text()).get("tok_out") or []
    at = at % len(tok_out) if tok_out else 0
    if not tok_out or int(tok_out[at]) != old:
        raise SystemExit(f"sash: {head} tok_out[{at}] is not reply position {t}'s id {old}")
    out.mkdir(parents=True, exist_ok=True)
    for p in sorted(src.iterdir()):
        if p.is_file():
            shutil.copyfile(p, out / p.name)
    (out / reply).write_text(edit_item((src / reply).read_text(), "tok_in", t, old, token))
    (out / head).write_text(edit_item((src / head).read_text(), "tok_out", at, old, token))
    return {**base("mutate_reply"), "mutated": {
        "parts": [reply, head], "fields": [f"{reply} tok_in[{t}]", f"{head} tok_out[{at}]"]}}


def write_npy(path: Path, ids: list[int]) -> None:
    """The ids as a NumPy file of int64 (format 1.0: magic, version, header length, a header
    padded to a multiple of 64 bytes, then the values little-endian), which `--ids` loads."""
    head = f"{{'descr': '<i8', 'fortran_order': False, 'shape': ({len(ids)},), }}".encode()
    head += b" " * (-(10 + len(head) + 1) % 64) + b"\n"
    path.write_bytes(b"\x93NUMPY\x01\x00" + struct.pack("<H", len(head)) + head
                     + struct.pack(f"<{len(ids)}q", *ids))  # fmt: skip


def bf16_of_key() -> list[float]:
    """The bf16 logit each order key stands for. extract.py writes `key_head.u16` as
    `sign ? 0x7FFF - mag : 0x8000 + mag` of the logit's bf16 pattern (U/harness/witness/
    extract.py L1187-L1193), so the key orders the logits and the map is inverted here."""
    out = []
    for key in range(1 << 16):
        sign, mag = (0, key - 0x8000) if key >= 0x8000 else (1, 0x7FFF - key)
        out.append(struct.unpack("<f", struct.pack("<I", ((sign << 15) | mag) << 16))[0])
    return out


def head_rows(dump: Path, rows: list[int], k: int, value: list[float]
              ) -> tuple[list[int], list[list[int]], list[list[float]]]:  # fmt: skip
    """For each row of a head dump: the token it emits (`tok_head.i32`, the lowest id among the
    largest logits, U/harness/witness/extract.py L1194-L1195) and, with k > 0, its k largest
    logits' ids (lower id first among equal logits) with their log-probabilities in nats: the
    log-softmax of the row's bf16 logits, computed in float64."""
    tok = array("i")
    tok.frombytes((dump / "tok_head.i32").read_bytes())
    s = len(tok)
    keys = dump / "key_head.u16"
    vocab, rest = divmod(keys.stat().st_size, 2 * s)
    if rest or vocab < max(1, k):
        raise SystemExit(f"sash: {keys} is not {s} rows of at least {max(1, k)} order keys")
    top, ids, lps = [], [], []
    with keys.open("rb") as f:
        for r in rows:
            top.append(int(tok[r]))
            if k <= 0:
                continue
            f.seek(2 * vocab * r)
            row = array("H")
            row.frombytes(f.read(2 * vocab))
            count = Counter(row)
            ordered = sorted(count, reverse=True)
            if value[ordered[0]] != value[ordered[0]] or value[ordered[0]] in (
                    float("inf"), float("-inf")):  # fmt: skip
                raise SystemExit(f"sash: row {r} of {keys} holds a logit that is not finite")
            peak = value[ordered[0]]
            lse = peak + math.log(math.fsum(n * math.exp(value[key] - peak)
                                            for key, n in count.items()))  # fmt: skip
            taken, floor = 0, ordered[-1]
            for key in ordered:  # the lowest key that the k largest logits reach
                taken += count[key]
                floor = key
                if taken >= k:
                    break
            best = sorted((-key, i) for i, key in enumerate(row) if key >= floor)[:k]
            if best[0][1] != top[-1]:
                raise SystemExit(f"sash: tok_head row {r} is not the lowest id among the "
                                 "largest logits of key_head")  # fmt: skip
            ids.append([i for _, i in best])
            lps.append([value[-key] - lse for key, _ in best])
    return top, ids, lps


def write_topk(path: Path, ids: list[list[int]], lps: list[list[float]]) -> None:
    """RFC-0018 AD-7: `TFK1`, the positions and k (uint32), then the ids (int32) and the
    log-probabilities (float32), each positions x k, row by row, little-endian."""
    flat_i = array("i", [t for row in ids for t in row])
    flat_f = array("f", [x for row in lps for x in row])
    path.write_bytes(b"TFK1" + struct.pack("<II", len(ids), len(ids[0])) + flat_i.tobytes()
                     + flat_f.tobytes())  # fmt: skip


def score(job: dict) -> dict:
    """RFC-0018 AD-7. For each request, `prove`'s own head extraction (the one command of
    `witness_and_plan` that passes `--head`) on prompt + reply as `--ids`, with the attention
    calibration `commit` kept. Row t of a head block predicts the token after its position t
    (U/harness/witness/extract.py L1217-L1228), so the reply's position 0 is the last row of
    the last prompt block's dump and positions 1 to S - 1 are rows 0 to S - 2 of the reply
    block's. A request the extractor refuses with an assertion (its no-wrap and fold checks,
    L992, L1017, L1111-L1124) is recorded as failed with that line; any other failure of the
    extraction stops the call, since it says nothing about the model."""
    g = geometry(job["shape"], model_layers())
    env, p, s, k = harness_env(), g["prompt"], g["s"], int(job.get("top_k", 0))
    ranges = ZK_OUT + "/attn_ranges.json"
    for given in job.get("prover_files", []):  # commit's files, from the harness's record
        kept = host(ZK_OUT) / Path(given).name
        if host(given).resolve() != kept.resolve():
            kept.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(host(given), kept)
    if not host(ranges).is_file():
        raise SystemExit(f"sash: no {ranges}: score needs the calibration commit kept")
    lines = host(job["requests_file"]).read_text().splitlines()
    requests = [json.loads(ln) for ln in lines if ln.strip()]
    out = job["out_dir"].rstrip("/")
    host(out).mkdir(parents=True, exist_ok=True)
    first, last = g["head_blocks"]  # type: ignore[misc]
    value = bf16_of_key() if k > 0 else []
    failed: list[int] = []
    seconds = 0.0
    for i, r in enumerate(requests):
        ids = [int(t) for t in [*r["prompt"], *r["reply"]]]
        if len(r["prompt"]) != p or len(r["reply"]) != s:
            raise SystemExit(f"sash: request {i} is not {p} prompt and {s} reply tokens")
        t0 = time.monotonic()
        wit = f"{STATE}/score-{i}"
        shutil.rmtree(host(wit), ignore_errors=True)
        host(wit).mkdir(parents=True)
        write_npy(host(f"{wit}/ids.npy"), ids)
        done = run([*UV, "-m", "harness.witness.extract", "--tokens", str(p + s), "--chunk", str(s),
                    "--layer", str(HEAD_LAYER), "--spec", SPEC, "--head", "--slim",
                    "--diagonal-block", "--blocks", f"{first},{last}", "--ids", f"{wit}/ids.npy",
                    "--attn-ranges", ranges, "--out", f"{wit}/head"],
                   cwd=HSRC, env=env, check=False)  # fmt: skip
        if done.returncode != 0:
            line = last_line(done.stderr)
            if not line.startswith("AssertionError"):
                tail = "\n".join(done.stderr.splitlines()[-50:])
                raise SystemExit(f"sash: the head extraction of request {i} exited "
                                 f"{done.returncode}\n{tail}")  # fmt: skip
            failed.append(i)
            write_json(f"{out}/{i}.json", {"failed": f"the extractor refused the ids: {line}"})
        else:
            a = head_rows(host(f"{wit}/head_B{first}"), [s - 1], k, value)
            b = head_rows(host(f"{wit}/head_B{last}"), list(range(s - 1)), k, value)
            top = a[0] + b[0]
            # the extractor's own count of rows that emit the next id (manifest `head`)
            manifest = json.loads(host(f"{wit}/head_B{last}/manifest.json").read_text())
            counted = (manifest.get("head") or {}).get("emits_next_token")
            if counted is not None and counted != sum(
                    x == y for x, y in zip(b[0], ids[p + 1:], strict=True)):  # fmt: skip
                raise SystemExit(f"sash: request {i}: the rows read here are not aligned as "
                                 f"the extractor counts them (emits_next_token {counted})")  # fmt: skip
            write_json(f"{out}/{i}.json", {"top": top})
            if k > 0:
                write_topk(host(f"{out}/{i}.topk"), a[1] + b[1], a[2] + b[2])
        shutil.rmtree(host(wit))
        seconds += time.monotonic() - t0
    return {**base("score"), "scores": {"dir": out, "requests": len(requests), "positions": s,
                                        "top_k": k, "failed": failed},
            "phases": [{"name": "score", "seconds": seconds}]}  # fmt: skip


def main() -> int:
    sub, job_path, out_path = sys.argv[1:4]
    job = json.loads(host(job_path).read_text())
    if job.get("subcommand") != sub:
        raise SystemExit(f"sash: job.json is for {job.get('subcommand')!r}, not {sub!r}")
    weakening = [f for f in job.get("control_flags", [])
                 if any(f.startswith(p) for p in FORBIDDEN_FLAGS)]  # fmt: skip
    if weakening and job.get("control") is not True:  # INV-ADAPTER-10, before any process
        raise SystemExit(f"sash: refusing {weakening} outside a control job")
    handlers = {"info": info, "setup": setup, "commit": commit, "prove": prove, "verify": verify,
                "perturb": perturb, "mutate_reply": mutate_reply, "score": score}  # fmt: skip
    if sub not in handlers:
        raise SystemExit(f"sash: no subcommand {sub!r}")
    host(out_path).write_text(json.dumps(handlers[sub](job), sort_keys=True, indent=2) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
