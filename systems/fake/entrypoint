#!/usr/bin/env python3
"""Fake prover for CI (RFC-0005 §Reference implementations). Standard library only.

Usage: entrypoint <info|setup|commit|prove|verify|probe> /io/job.json /io/out.json

The proof for one request is two parts: body.bin = sha256(key || request), and
tag.bin = HMAC-SHA256(key, request || claimed_output || body). The prover keys with the
commitment of the weights it loads; the verifier keys with the commitment_id the harness
passes from its own commit record. Any change to the request, the output, the commitment,
the weights or a part therefore changes an HMAC input and the verifier rejects it.

IPROOFS_IO and IPROOFS_MODELS map /io and /models to host directories when the harness runs
this file in process instead of in a container. IPROOFS_FAKE_DELAY_S sets the pause between
proof releases (default 0.05 s) so prove.steady is observable. IPROOFS_FAKE_ACCEPT_ALL=1
turns the verifier into one that accepts everything (systems/fake-broken).
IPROOFS_FAKE_FAULT makes `prove` misbehave for the integration tests (docs/spec/07): `exit`
exits 3, `sleep` outlasts any timeout, `escape` lists a part outside its proof directory, and
`network` tries to reach the network and exits 3 when it cannot.
"""

import hashlib
import hmac
import json
import os
import socket
import sys
import time
from pathlib import Path

FORBIDDEN_FLAGS = ["--unsound-skip-"]
UPSTREAM_COMMIT = os.environ.get("IPROOFS_FAKE_UPSTREAM", "0" * 40)
MIN_PART_BYTES = 32


def host(container_path: str) -> Path:
    for prefix, env in (("/io", "IPROOFS_IO"), ("/models", "IPROOFS_MODELS")):
        if container_path == prefix or container_path.startswith(prefix + "/"):
            return Path(os.environ.get(env, prefix) + container_path[len(prefix) :])
    raise SystemExit(f"fake: path {container_path!r} outside /io and /models")


def model_commitment(model_dir: Path) -> str:
    """sha256 over the RFC-0012 model digest string of the loaded weights."""
    h = hashlib.sha256()
    for path in sorted(p for p in model_dir.rglob("*") if p.is_file()):
        name = path.relative_to(model_dir).as_posix()
        h.update(f"{name}\t{hashlib.sha256(path.read_bytes()).hexdigest()}\n".encode())
    return hashlib.sha256(("sha256:" + h.hexdigest()).encode()).hexdigest()


def claimed_output(request: list[int]) -> list[int]:
    """A deterministic function of the request: one token id below 256."""
    return [hashlib.sha256(json.dumps(request).encode()).digest()[0]]


def tag(key: str, request: list[int], output: list[int], body: bytes) -> bytes:
    msg = json.dumps(request).encode() + b"|" + json.dumps(output).encode() + b"|" + body
    return hmac.new(key.encode(), msg, hashlib.sha256).digest()


def log_command(argv: list[str], started: int, exit_code: int) -> None:
    line = {"argv": argv, "cwd": "/io", "started_mono_ns": started, "exit_code": exit_code}
    with host("/io/commands.jsonl").open("a") as f:
        f.write(json.dumps(line, sort_keys=True) + "\n")


def base(sub: str) -> dict[str, object]:
    return {"schema": "adapter-out/1", "contract": "adapter/1", "subcommand": sub,
            "phases": [], "warnings": []}


INPUTS = Path("/opt/iproofs/inputs.json")  # written at build time (RFC-0014 B5)


def info(job: dict) -> dict:
    inputs = json.loads(INPUTS.read_text())["inputs"] if INPUTS.is_file() else []
    out = {**base("info"), "system": os.environ.get("IPROOFS_FAKE_NAME", "fake"),
           "upstream_commit": UPSTREAM_COMMIT, "image_inputs": inputs,
           "workloads": ["fake-tiny-ci"], "profile": "ci-cpu",
           "contract_versions": ["adapter/1"]}
    if "IPROOFS_ADAPTER_COMMIT" in os.environ:  # baked in by the image build (B6)
        out["adapter_commit"] = os.environ["IPROOFS_ADAPTER_COMMIT"]
        out["adapter_dirty"] = os.environ.get("IPROOFS_ADAPTER_DIRTY", "true") != "false"
    return out


def setup(job: dict) -> dict:
    return {**base("setup"), "ready": True, "log_files": []}


def commit(job: dict) -> dict:
    state = host("/io/state")
    state.mkdir(parents=True, exist_ok=True)
    key = model_commitment(host(job["model_dir"]))
    return {**base("commit"), "commitment_id": key, "verifier_files": [], "prover_files": [],
            "sizes": {"verifier_bytes": 0, "prover_bytes": 0}}


def prove(job: dict) -> dict:
    flags = job.get("control_flags", [])
    weakening = [f for f in flags if any(f.startswith(p) for p in FORBIDDEN_FLAGS)]
    if weakening and not job["control"]:  # RFC-0005 rule 4
        raise SystemExit(f"fake: refusing {weakening} outside a control job")
    fault = os.environ.get("IPROOFS_FAKE_FAULT", "")
    if fault == "exit":
        print("fake: injected prove failure", file=sys.stderr)
        raise SystemExit(3)
    if fault == "sleep":
        time.sleep(3600)
    if fault == "network":
        try:
            socket.create_connection(("example.com", 443), timeout=5).close()
        except OSError as e:
            print(f"fake: network unreachable: {e}", file=sys.stderr)
            raise SystemExit(3) from e
        print("fake: network reachable", file=sys.stderr)
    started = time.monotonic_ns()
    key = model_commitment(host(job["model_dir"]))  # the weights actually loaded
    prompts = [json.loads(line) for line in host(job["prompts_file"]).read_text().splitlines()]
    count = job["batch_size"] * job["batches"]
    proofs_dir = host("/io/proofs")
    proofs_dir.mkdir(parents=True, exist_ok=True)
    delay = float(os.environ.get("IPROOFS_FAKE_DELAY_S", "0.05"))
    proofs = []
    for i, request in enumerate(prompts[:count]):
        proof_id = f"req-{i}"
        output = claimed_output(request)
        body = hashlib.sha256(key.encode() + json.dumps(request).encode()).digest()
        tmp = proofs_dir / f".tmp-{proof_id}"
        tmp.mkdir()
        (tmp / "body.bin").write_bytes(body)
        (tmp / "tag.bin").write_bytes(tag(key, request, output, body))
        os.rename(tmp, proofs_dir / proof_id)  # atomic release (RFC-0005 §Proof release protocol)
        parts = ["body.bin", "../../etc/passwd" if fault == "escape" else "tag.bin"]
        proofs.append({"proof_id": proof_id, "request_index": i,
                       "parts": parts, "claimed_output": output})
        time.sleep(delay)
    log_command(["fake-prover", "prove", *flags], started, 0)
    # the binding report (RFC-0008): the tag edge is unbound only when its skip was passed
    unbound = "--unsound-skip-tag" in flags
    host("/io/binding.json").write_text(json.dumps({"edges": {"tag": "unbound" if unbound else "bound"}}))
    return {**base("prove"), "proofs": proofs, "binding_report": "/io/binding.json"}


def verify(job: dict) -> dict:
    started = time.monotonic_ns()
    proof = host(job["proof_dir"])
    parts = {name: proof / name for name in ("body.bin", "tag.bin")}
    if os.environ.get("IPROOFS_FAKE_ACCEPT_ALL") == "1":
        verdict, code, line = "accept", 0, "ACCEPT (broken verifier)"
    elif any(not p.is_file() or p.stat().st_size < MIN_PART_BYTES for p in parts.values()):
        verdict, code, line = "invalid_call", 2, "part missing or truncated"
    else:
        body = parts["body.bin"].read_bytes()
        want = tag(job["commitment_id"], job["request"], job["claimed_output"], body)
        ok = hmac.compare_digest(want, parts["tag.bin"].read_bytes())
        verdict, code, line = ("accept", 0, "ACCEPT") if ok else ("reject", 1, "tag mismatch")
    seconds = (time.monotonic_ns() - started) / 1e9
    log_command(["fake-verifier", "verify"], started, code)
    return {**base("verify"), "verdict": verdict, "raw_exit_code": code,
            "raw_last_line": line, "seconds": seconds}


def probe(job: dict) -> None:
    """The self-test probe (RFC-0011 §Calibration self-test), never part of a measured run.
    `alloc` touches `mib` (default 256) MiB of anonymous memory and holds it `hold_s` (default
    1) seconds, `watch` releases 3 directories 200 ms apart, `oom` allocates past the
    container's memory limit."""
    mode = job["probe"]
    if mode in ("alloc", "oom"):
        size = int(job.get("mib", 256) if mode == "alloc" else 1024) * 1024 * 1024
        block = bytearray(size)
        for i in range(0, size, 4096):
            block[i] = 1  # touch every page so it is resident
        time.sleep(float(job.get("hold_s", 1.0)))  # 1 s is long enough for the 10 Hz sampler
    elif mode == "watch":
        proofs = host("/io/proofs")
        proofs.mkdir(parents=True, exist_ok=True)
        for i in range(3):
            if i:
                time.sleep(0.2)
            (proofs / f".tmp-p{i}").mkdir()
            os.rename(proofs / f".tmp-p{i}", proofs / f"p{i}")


def main() -> int:
    sub, job_path, out_path = sys.argv[1:4]
    job = json.loads(host(job_path).read_text())
    if sub == "probe":
        probe(job)
        return 0
    if job.get("subcommand") != sub:
        raise SystemExit(f"fake: job.json is for {job.get('subcommand')!r}, not {sub!r}")
    out = {"info": info, "setup": setup, "commit": commit, "prove": prove, "verify": verify}[sub](job)
    host(out_path).write_text(json.dumps(out, sort_keys=True, indent=2) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
